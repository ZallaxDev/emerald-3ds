 #include "event_data.h"
 #include "mystery_gift.h"
 #include "util.h"
@@ -127,6 +128,20 @@ bool8 RunScriptCommand(struct ScriptContext *ctx)
 
             if (func >= ctx->cmdTableEnd)
             {
+                u8 result;
+
+                if (cmdCode >= SCRIPT_CMD_EXT_SINGLE_BASE && cmdCode < SCRIPT_CMD_EXT_PREFIX)
+                    result = ScriptExt_DispatchCommand(ctx, cmdCode);
+                else if (cmdCode == SCRIPT_CMD_EXT_PREFIX)
+                    result = ScriptExt_DispatchCommand(ctx, SCRIPT_CMD_EXT_EXTENDED_BASE + *(ctx->scriptPtr++));
+                else
+                    result = SCRIPT_EXT_UNHANDLED;
+
+                if (result == SCRIPT_EXT_YIELD)
+                    return TRUE;
+                if (result == SCRIPT_EXT_CONTINUE)
+                    continue;
+
                 ctx->mode = SCRIPT_MODE_STOPPED;
                 return FALSE;
             }
@@ -325,9 +340,21 @@ u8 *MapHeaderGetScriptTable(u8 tag)
 
 void MapHeaderRunScriptType(u8 tag)
 {
-    u8 *ptr = MapHeaderGetScriptTable(tag);
+    u8 *ptr;
+
+    if (tag >= MAP_SCRIPT_EXT_TAG_BASE)
+    {
+        ScriptExt_RunMapScript(tag);
+        return;
+    }
+
+    ptr = MapHeaderGetScriptTable(tag);
     if (ptr)
         RunScriptImmediately(ptr);
+
+    // Extension handlers for this lifecycle event live at BASE + the stock tag
+    // (0x80 = ON_LOAD, 0x81 = ON_TRANSITION, ...).
+    ScriptExt_RunMapScript(MAP_SCRIPT_EXT_TAG_BASE + tag);
 }
 

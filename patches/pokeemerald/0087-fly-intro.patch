+static void FlyIntro_MonOut(struct Task *task)
+{
+    struct ObjectEvent *objectEvent = &gObjectEvents[gPlayerAvatar.objectEventId];
+    struct Sprite *player, *mon;
+    u8 spriteId;
+
+    if (!ObjectEventClearHeldMovementIfFinished(objectEvent))
+        return;
+    player = &gSprites[objectEvent->spriteId];
+    sFlyRiderX = 0;
+    sFlyRiderY = -8;
+    spriteId = FollowerMon_FlySprite(sFlyMonSpecies, sFlyMonPersonality, sFlyMonShiny, sFlyEast, 0, 0, 1,
+                                     &sFlyRiderX, &sFlyRiderY);
+    if (spriteId >= MAX_SPRITES)
+    {
+        // No sprite after all: the GBA's start, from its banner on.
+        task->tIntro = FALSE;
+        task->tState = 1;
+        return;
+    }
+    if (task->tAvatarFlags & PLAYER_AVATAR_FLAG_SURFING)
+    {
+        SetSurfBlob_BobState(objectEvent->fieldEffectSpriteId, BOB_JUST_MON);
+        SetSurfBlob_DontSyncAnim(objectEvent->fieldEffectSpriteId, FALSE);
+    }
+    mon = &gSprites[spriteId];
+    // On the free tile beside the player - to the right where it can, else
+    // left, in front, behind; none free, on the player's own tile - in the
+    // map's own coordinates (coordOffsetEnabled, as an object's sprite), so
+    // the port covers it with the voxel world as it covers an NPC; its
+    // feet on the ground line (an object sprite's bottom is 16 under its
+    // centre).
+    {
+        static const u8 sides[] = {DIR_EAST, DIR_WEST, DIR_SOUTH, DIR_NORTH};
+        s16 dx = 0, dy = 0;
+        u8 i;
+
+        task->tSide = objectEvent->facingDirection;
+        for (i = 0; i < ARRAY_COUNT(sides); i++)
+        {
+            s16 tx, ty;
+
+            FlyIntro_Step(sides[i], &tx, &ty);
+            if (GetCollisionAtCoords(objectEvent, objectEvent->currentCoords.x + tx, objectEvent->currentCoords.y + ty, sides[i]) == COLLISION_NONE)
+            {
+                task->tSide = sides[i];
+                dx = tx;
+                dy = ty;
+                break;
+            }
+        }
+        task->tMonX = player->x + 16 * dx;
+        task->tMonY = player->y + 16 * dy + 16 - FollowerMon_FlyFeet();
+    }
+    mon->x = task->tMonX;
+    mon->y = task->tMonY;
+    mon->x2 = 0;
+    mon->y2 = 0;
+    mon->coordOffsetEnabled = TRUE;
+    mon->oam.priority = 1;
+    mon->oam.affineMode = ST_OAM_AFFINE_DOUBLE;
+    mon->affineAnims = sAffineAnims_FlyMonOut;
+    InitSpriteAffineAnim(mon);
+    StartSpriteAffineAnim(mon, 0);
+    mon->callback = SpriteCallbackDummy;
+    task->tBirdSpriteId = spriteId;
+    task->tTimer = 0;
+    {
+        s16 dx, dy;
+
+        FlyIntro_Step(task->tSide, &dx, &dy);
+        task->tShadow = FlyShadow_Create(spriteId, dx, dy, player->x + 16 * dx, player->y + 16 * dy + 12);
+    }
+    PlayCry_Normal(sFlyMonSpecies, 0);
+    FlyIntro_Sparkle(task->tSide, 1);
+    task->tState++;
+}
+
+static void FlyIntro_Grow(struct Task *task)
+{
+    struct Sprite *mon = &gSprites[task->tBirdSpriteId];
+    u8 ext = GetSpriteExtPalette(mon);
+    s16 t = task->tTimer;
+
+    // White into its colours as it grows: its ext palette's own place in
+    // the palette buffers (UpdateSpritePaletteExtWithWeather), blended from
+    // the unfaded one each frame, the weather's tint put back at the end.
+    if (ext != 0xFF)
+    {
+        u16 coeff = t >= FLY_INTRO_GROW ? 0 : 16 - (t * 16) / FLY_INTRO_GROW;
+
+        BlendPalette(PLTT_ID(32 + ext), 16, coeff, RGB_WHITE);
+        if (coeff == 0)
+            UpdateSpritePaletteExtWithWeather(ext);
+    }
+    if (t == 7 || t == 15)
+        FlyIntro_Sparkle(task->tSide, t);
+    if (++task->tTimer >= FLY_INTRO_GROW + 2)
+    {
+        mon->oam.affineMode = ST_OAM_AFFINE_OFF;
+        FreeOamMatrix(mon->oam.matrixNum);
+        CalcCenterToCornerVec(mon, mon->oam.shape, mon->oam.size, ST_OAM_AFFINE_OFF);
+        // The player turns to it.
+        SetPlayerAvatarTransitionFlags(PLAYER_AVATAR_FLAG_ON_FOOT);
+        ObjectEventSetHeldMovement(&gObjectEvents[gPlayerAvatar.objectEventId],
+                                   GetFaceDirectionMovementAction(task->tSide));
+        task->tTimer = 0;
+        task->tState++;
+    }
+}
+
+static void FlyIntro_Turn(struct Task *task)
+{
+    struct ObjectEvent *objectEvent = &gObjectEvents[gPlayerAvatar.objectEventId];
+
+    if (++task->tTimer >= FLY_INTRO_SETTLE && ObjectEventClearHeldMovementIfFinished(objectEvent))
+    {
+        struct Sprite *player;
+
+        // The hop: the getting-on frames carried along the ledge jump's arc
+        // across onto the seat by FlyIntro_Hop.
+        ObjectEventSetGraphicsId(objectEvent, GetPlayerAvatarGraphicsIdByStateId(PLAYER_AVATAR_STATE_SURFING));
+        player = &gSprites[objectEvent->spriteId];
+        StartSpriteAnim(player, task->tSide == DIR_EAST ? ANIM_GET_ON_OFF_POKEMON_EAST
+                              : task->tSide == DIR_WEST ? ANIM_GET_ON_OFF_POKEMON_WEST
+                              : task->tSide == DIR_NORTH ? ANIM_GET_ON_OFF_POKEMON_NORTH : ANIM_GET_ON_OFF_POKEMON_SOUTH);
+        objectEvent->inanimate = TRUE;
+        PlaySE(SE_LEDGE);
+        // From here both are the picture's sprites (the port draws an object
+        // at its tile and places other map sprites by the player's, so a
+        // hop in the map's coordinates would move the Pokemon, not the
+        // player; the camera's flight leaves the map anyway). The port lays
+        // Fly's picture sprites where the camera sees the player, taking the
+        // player's sprite to be at the GBA's (120, 72), and zooms them to the
+        // size the voxel world draws a map sprite there: the two go there as
+        // they stood.
+        {
+            struct Sprite *mon = &gSprites[task->tBirdSpriteId];
+            s16 dx = 120 - player->x, dy = 72 - player->y;
+
+            mon->coordOffsetEnabled = FALSE;
+            task->tMonX += dx;
+            task->tMonY += dy;
+            mon->x = task->tMonX;
+            mon->y = task->tMonY;
+            // ... the shadow stays on the ground; the player's sprite at
+            // the picture's place of the player.
+            FlyShadow_Picture(task->tShadow, task->tMonY + FollowerMon_FlyFeet());
+            player->coordOffsetEnabled = FALSE;
+            player->x = 120;
+            player->y = 72;
+        }
+        task->tPlayerX = 120;
+        task->tPlayerY = 72;
+        task->tTimer = 0;
+        // The cinematic's camera starts with the hop: its first beat (the
+        // bird's dive, on the GBA) is about the hop's length.
+        Port_FlyHover();
+        task->tState++;
     }
 }
 
+static void FlyIntro_Hop(struct Task *task)
+{
+    struct Sprite *player = &gSprites[gObjectEvents[gPlayerAvatar.objectEventId].spriteId];
+    s16 t = ++task->tTimer;
+    s16 seatX = task->tMonX + sFlyRiderX, seatY = task->tMonY + sFlyRiderY;
+
+    if (t > FLY_INTRO_HOP)
+        t = FLY_INTRO_HOP;
+    player->x = task->tPlayerX + ((seatX - task->tPlayerX) * t) / FLY_INTRO_HOP;
+    player->y = task->tPlayerY + ((seatY - task->tPlayerY) * t) / FLY_INTRO_HOP;
+    player->x2 = 0;
+    player->y2 = -(s16)((4 * FLY_INTRO_HOP_RISE * (s32)t * (FLY_INTRO_HOP - t)) / (FLY_INTRO_HOP * FLY_INTRO_HOP));
+    if (task->tTimer >= FLY_INTRO_HOP)
+        task->tState++;
+}
+
+static void FlyIntro_TakeOff(struct Task *task)
+{
+    struct ObjectEvent *objectEvent = &gObjectEvents[gPlayerAvatar.objectEventId];
+    struct Sprite *mon = &gSprites[task->tBirdSpriteId];
+
+    ObjectEventClearHeldMovementIfActive(objectEvent);
+    objectEvent->inanimate = FALSE;
+    objectEvent->hasShadow = FALSE;
+    if (task->tAvatarFlags & PLAYER_AVATAR_FLAG_SURFING)
+        DestroySprite(&gSprites[objectEvent->fieldEffectSpriteId]);
+    // Seated the way the flight goes (the hop faced the Pokemon): the frame
+    // drawn now - an object standing still has its animation paused.
+    StartSpriteAnim(&gSprites[objectEvent->spriteId], sFlyEast ? ANIM_GET_ON_OFF_POKEMON_EAST : ANIM_GET_ON_OFF_POKEMON_WEST);
+    gSprites[objectEvent->spriteId].animPaused = FALSE;
+    AnimateSprite(&gSprites[objectEvent->spriteId]);
+    StartFlyBirdSwoopDown(task->tBirdSpriteId); // the fly-off's sprite data, the callback set below
+    mon->callback = SpriteCB_FlyMonTakeOff;
+    mon->x = task->tMonX;
+    mon->y = task->tMonY;
+    SetFlyBirdPlayerSpriteId(task->tBirdSpriteId, objectEvent->spriteId);
+    CameraObjectFreeze();
+    PlaySE(SE_M_FLY);
+    task->tState++;
+}
+
+// Off the ground with the player aboard: up, gathering speed, leaning the
+// way it goes, as long as the camera climbs (Port_FlyHover); let go, it
+// goes on as the bird's own fly-off (SpriteCB_FlyBirdSwoopDown) from where
+// it is, at FLY_TAKEOFF_ANGLE of it.
+#define sTakeOffFrames data[3]
+static void SpriteCB_FlyMonTakeOff(struct Sprite *sprite)
+{
+    struct Sprite *rider = &gSprites[sprite->sPlayerSpriteId];
+    s16 h = ++sprite->sTakeOffFrames;
+
+    if (Port_FlyHover())
+    {
+        if (h > 64)
+            h = 64;
+        sprite->y2 = -(h * h) / 48;
+        sprite->x2 = FLY_MIRROR_DX(-(h * h) / 160);
+    }
+    else
+    {
+        sprite->x += sprite->x2 - FLY_MIRROR_DX(FlySwoopX(FLY_TAKEOFF_ANGLE));
+        sprite->y += sprite->y2 - Sin(FLY_TAKEOFF_ANGLE, 0x48);
+        sprite->x2 = FLY_MIRROR_DX(FlySwoopX(FLY_TAKEOFF_ANGLE));
+        sprite->y2 = Sin(FLY_TAKEOFF_ANGLE, 0x48);
+        sprite->data[2] = FLY_TAKEOFF_ANGLE;
+        sprite->callback = SpriteCB_FlyBirdSwoopDown;
+    }
+    rider->coordOffsetEnabled = FALSE;
+    rider->x = sprite->x + sprite->x2 + sFlyRiderX;
+    rider->y = sprite->y + sprite->y2 + sFlyRiderY;
+    rider->x2 = 0;
+    rider->y2 = 0;
+}

+// A sparkle beside the Pokemon coming out (the grass's, FLDEFF_SPARKLE),
+// nudged off the tile's centre by `seed`.
+static void FlyIntro_Sparkle(u8 side, s16 seed)
+{
+    struct ObjectEvent *objectEvent = &gObjectEvents[gPlayerAvatar.objectEventId];
+    s16 dx, dy;
+    u8 i;
+
+    FlyIntro_Step(side, &dx, &dy);
+    gFieldEffectArguments[0] = objectEvent->currentCoords.x - MAP_OFFSET + dx;
+    gFieldEffectArguments[1] = objectEvent->currentCoords.y - MAP_OFFSET + dy;
+    gFieldEffectArguments[2] = 1;
+    FieldEffectStart(FLDEFF_SPARKLE);
+    for (i = 0; i < MAX_SPRITES; i++)
+    {
+        struct Sprite *sprite = &gSprites[i];
+
+        if (sprite->inUse && sprite->callback == UpdateSparkleFieldEffect && sprite->data[2] == 0)
+        {
+            sprite->data[2] = 1;
+            sprite->x2 = (seed * 7) % 13 - 6;
+            sprite->y2 = (seed * 5) % 9 - 10;
+        }
+    }
+}

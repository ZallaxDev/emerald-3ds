+
+static void SpriteCB_FlyShadow(struct Sprite *sprite)
+{
+    struct Sprite *mon = &gSprites[sprite->sShadowMon];
+    s16 bottom;
+
+    if (!mon->inUse || !FollowerMon_IsFlySprite(mon))
+    {
+        DestroySprite(sprite);
+        return;
+    }
+    bottom = mon->y + mon->y2 + sprite->sShadowFeet;
+    if (!sprite->sShadowPicture)
+        sprite->sShadowGround = bottom; // on the ground still: under its feet
+    sprite->oam.priority = mon->oam.priority;
+    sprite->invisible = mon->invisible || mon->callback == SpriteCB_FlyBirdReturnToBall
+                     || sprite->sShadowGround - bottom > FLY_SHADOW_HEIGHT;
+}
 
+// The shadow on the tile `dx, dy` from the player's (map sprite coordinates
+// `x, y` of its own: the 2D field draws it there).
+static u8 FlyShadow_Create(u8 monSpriteId, s16 dx, s16 dy, s16 x, s16 y)
+{
+    const struct ObjectEvent *player = &gObjectEvents[gPlayerAvatar.objectEventId];
+    const struct Sprite *mon = &gSprites[monSpriteId];
+    u8 kind = mon->oam.size == ST_OAM_SIZE_3 ? FLDEFFOBJ_SHADOW_L : FLDEFFOBJ_SHADOW_M;
+    u8 spriteId;
+
+    sFlyShadowTemplate = *gFieldEffectObjectTemplatePointers[kind];
+    sFlyShadowTemplate.callback = SpriteCB_FlyShadow;
+    spriteId = CreateSpriteAtEnd(&sFlyShadowTemplate, x, y, 148);
+    if (spriteId < MAX_SPRITES)
+    {
+        struct Sprite *sprite = &gSprites[spriteId];
+
+        sprite->sShadowMon = monSpriteId;
+        sprite->sShadowTileX = player->currentCoords.x + dx;
+        sprite->sShadowTileY = player->currentCoords.y + dy;
+        sprite->sShadowFeet = FollowerMon_FlyFeet();
+        sprite->sShadowGround = mon->y + mon->y2 + sprite->sShadowFeet;
+        sprite->sShadowPicture = FALSE;
+        sprite->coordOffsetEnabled = TRUE;
+        sprite->oam.priority = mon->oam.priority;
+    }
+    return spriteId;
+}
+
+// The Pokemon has gone onto the picture, its ground line there at `ground`.
+static void FlyShadow_Picture(u8 shadowSpriteId, s16 ground)
+{
+    if (shadowSpriteId < MAX_SPRITES && gSprites[shadowSpriteId].callback == SpriteCB_FlyShadow)
+    {
+        gSprites[shadowSpriteId].sShadowPicture = TRUE;
+        gSprites[shadowSpriteId].sShadowGround = ground;
+    }
+}

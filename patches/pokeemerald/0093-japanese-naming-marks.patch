Emerald 3DS: apply Japanese naming marks to the preceding kana.

diff --git a/src/naming_screen.c b/src/naming_screen.c
--- a/src/naming_screen.c
+++ b/src/naming_screen.c
@@ -31,6 +31,7 @@
 #include "constants/rgb.h"
 #ifdef PLATFORM_3DS
 #include "3ds_game_views.h"
+#include "3ds_naming_kana.h"
 
 // The bottom screen's own keyboard (CtrNaming_GetView, CtrNaming_NativeTap).
 bool8 CtrMenu_TakeAck(void);
@@ -1242,15 +1243,28 @@
 }
 
 // If the cursor's x is equal to the column count, cursor is in the button column
-static u8 GetCurrentPageColumnCount(void)
-{
 #ifdef JAPANESE_KEYBOARD
+static u8 GetJapaneseKeyboardColumnCount(void)
+{
     u8 i, count = 0;
 
     for (i = 0; i < KBROW_COUNT; i++)
         if (StringLength(sNamingScreenKeyboardText[CurrentPageToKeyboardId()][i]) > count)
             count = StringLength(sNamingScreenKeyboardText[CurrentPageToKeyboardId()][i]);
     return count;
+}
+#endif
+
+static u8 GetCurrentPageColumnCount(void)
+{
+#ifdef JAPANESE_KEYBOARD
+    u8 count = GetJapaneseKeyboardColumnCount();
+
+#ifdef PLATFORM_3DS
+    if (CurrentPageToKeyboardId() != KEYBOARD_SYMBOLS)
+        count++; // One additional column holds the two kana marks.
+#endif
+    return count;
 #else
     return sPageColumnCounts[CurrentPageToKeyboardId()];
 #endif
@@ -1861,6 +1875,15 @@
 #ifdef JAPANESE_KEYBOARD
     const u8 *row = sNamingScreenKeyboardText[CurrentPageToKeyboardId()][y];
 
+#ifdef PLATFORM_3DS
+    if (CurrentPageToKeyboardId() != KEYBOARD_SYMBOLS && x == GetJapaneseKeyboardColumnCount())
+    {
+        if (y == 0)
+            return CTR_NAMING_DAKUTEN;
+        if (y == 1)
+            return CTR_NAMING_HANDAKUTEN;
+    }
+#endif
     return x < StringLength(row) ? row[x] : CHAR_SPACE;
 #else
     return sKeyboardChars[CurrentPageToKeyboardId()][y][x];

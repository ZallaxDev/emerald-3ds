+#ifdef PLATFORM_3DS
+bool8 CtrNaming_IsOpen(void)
+{
+    return sNamingScreen != NULL
+        && gMain.callback2 == CB2_NamingScreen
+        && (sNamingScreen->state == STATE_HANDLE_INPUT || sNamingScreen->state == STATE_MOVE_TO_OK_BUTTON);
+}

+const u8 *CtrNaming_GetText(void)
+{
+    if (sNamingScreen == NULL)
+        return NULL;
+    return sNamingScreen->textBuffer;
+}
+
+u8 CtrNaming_GetMaxChars(void)
+{
+    if (sNamingScreen == NULL || sNamingScreen->template == NULL)
+        return 0;
+    return sNamingScreen->template->maxChars;
+}
+
+u8 CtrNaming_GetCaretPos(void)
+{
+    if (sNamingScreen == NULL)
+        return 0;
+    return GetTextEntryPosition();
+}
+
+void CtrNaming_InputChar(u8 ch)
+{
+    if (!CtrNaming_IsOpen())
+        return;
+    if (GetPreviousTextCaretPosition() < sNamingScreen->template->maxChars - 1
+        || sNamingScreen->textBuffer[sNamingScreen->template->maxChars - 1] == EOS)
+    {
+        BufferCharacter(ch);
+        DrawTextEntry();
+        CopyBgTilemapBufferToVram(3);
+        PlaySE(SE_SELECT);
+    }
+}
+
+void CtrNaming_Backspace(void)
+{
+    if (!CtrNaming_IsOpen())
+        return;
+    DeleteTextCharacter();
+}
+
+void CtrNaming_Confirm(void)
+{
+    if (!CtrNaming_IsOpen())
+        return;
+    PlaySE(SE_SELECT);
+    sNamingScreen->state = STATE_PRESSED_OK;
+}

+// German berry names take BEERE/BEEREN as a suffix.
+const u8 gText_Berries[] = _("BEEREN");
 #elif CTR_LANG_PT_BR
--- a/src/battle_message.c
+++ b/src/battle_message.c
@@ -65,2 +65,7 @@

German-only layout additions on top of the current Emerald 3DS patch set.
Preserves the Portuguese branches and the other cartridge languages.
Applies after 0080-german-ending-tilemap.patch with tools/bootstrap.py.

--- a/src/item.c
+++ b/src/item.c
@@ -120,2 +120,7 @@
     StringCopy(txtPtr, berryName);
+#elif defined(PORT_BRIDGE) && GAME_LANGUAGE == LANGUAGE_GERMAN
+    // German berry names are the fruit alone and BEERE/BEEREN is a suffix:
+    // one word, no space (AMRENA + BEERE).
+    txtPtr = StringCopy(dst, berryName);
+    StringCopy(txtPtr, berryString);
 #else
--- a/src/strings.c
+++ b/src/strings.c
@@ -1833,2 +1833,5 @@
 const u8 gText_Berries[] = _("BAYAS");

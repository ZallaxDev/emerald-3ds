     CtrBattleHud_SetHp(healthboxSpriteId, value, maxOrCurrent != HP_CURRENT);
 #endif
 
+#ifdef JAPANESE_HEALTHBOX_NUMBERS
+    if (FALSE) // the Japanese game draws them below, with the bold font
+#else
     if (GetBattlerSide(gSprites[healthboxSpriteId].hMain_Battler) == B_SIDE_PLAYER && !IsDoubleBattle())
+#endif
     {
         spriteTileNum = gSprites[healthboxSpriteId].oam.tileNum * TILE_SIZE_4BPP;
         if (maxOrCurrent != HP_CURRENT) // singles, max
@@ -1956,6 +1999,64 @@ static void SpriteCB_StatusSummaryBalls_OnSwitchout(struct Sprite *sprite)
     sprite->y2 = gSprites[barSpriteId].y2;
 }
 
+#ifdef JAPANESE_HEALTHBOX_NUMBERS
+// The Japanese game's nickname: six characters in the bold font, each over the
+// box's top tile (the one with room for its dakuten or handakuten), so the
+// "Lv" that its healthbox graphics carry stays visible.
+static void UpdateNickInHealthbox(u8 healthboxSpriteId, struct Pokemon *mon)
+{
+    u8 nickname[POKEMON_NAME_LENGTH + 1];
+    u8 *ptr, *pixels;
+    u8 gender, battler = gSprites[healthboxSpriteId].hMain_Battler;
+    u16 species;
+    s32 i, len;
+    u32 tile = gSprites[healthboxSpriteId].oam.tileNum, first;
+
+    StringCopy(gDisplayedStringBattle, gText_HealthboxNickname);
+    GetMonData(mon, MON_DATA_NICKNAME, nickname);
+    StringGet_Nickname(nickname);
+    ptr = StringAppend(gDisplayedStringBattle, nickname);
+
+    gender = GetMonGender(mon);
+    species = GetMonData(mon, MON_DATA_SPECIES);
+    if ((species == SPECIES_NIDORAN_F || species == SPECIES_NIDORAN_M) && StringCompare(nickname, gSpeciesNames[species]) == 0)
+        gender = 100;
+    if (gender == MON_MALE)
+        StringCopy(ptr, gText_HealthboxGender_Male);
+    else if (gender == MON_FEMALE)
+        StringCopy(ptr, gText_HealthboxGender_Female);
+    else
+        StringCopy(ptr, gText_HealthboxGender_None);
+
+    pixels = gMonSpritesGfxPtr->barFontGfx + 0x520 + GetBattlerPosition(battler) * 0x180;
+    len = StringLength(gDisplayedStringBattle);
+    StringFill(gDisplayedStringBattle + len, CHAR_SPACE, 12 - len);
+    len = (u16)(StringLength(gDisplayedStringBattle) - 6);
+    RenderTextHandleBold(pixels, FONT_BOLD, gDisplayedStringBattle);
+    for (i = 0; i < len; i++)
+    {
+        u8 c = gDisplayedStringBattle[3 + i];
+        u32 element;
+
+        if ((u8)(c - 0x37) <= 19 || (u8)(c - 0x87) <= 19)
+            element = HEALTHBOX_GFX_44;
+        else if ((u8)(c - 0x4B) <= 4 || (u8)(c - 0x9B) <= 4)
+            element = HEALTHBOX_GFX_45;
+        else
+            element = HEALTHBOX_GFX_43;
+        CpuCopy32(GetHealthboxElementGfxPtr(element), pixels + i * 64, TILE_SIZE_4BPP);
+    }
+
+    first = GetBattlerSide(battler) == B_SIDE_PLAYER ? 2 : 1;
+    for (i = 0; i < len; i++)
+    {
+        CpuCopy32(pixels, (void *)(OBJ_VRAM0 + (tile + first + i) * TILE_SIZE_4BPP), TILE_SIZE_4BPP);
+        pixels += TILE_SIZE_4BPP;
+        CpuCopy32(pixels, (void *)(OBJ_VRAM0 + (tile + first + 8 + i) * TILE_SIZE_4BPP), TILE_SIZE_4BPP);
+        pixels += TILE_SIZE_4BPP;
+    }
+}
+#else
 static void UpdateNickInHealthbox(u8 healthboxSpriteId, struct Pokemon *mon)
 {
     u8 nickname[POKEMON_NAME_LENGTH + 1];
@@ -2016,6 +2117,7 @@ static void UpdateNickInHealthbox(u8 healthboxSpriteId, struct Pokemon *mon)
 
     RemoveWindowOnHealthbox(windowId);
 }
+#endif
 

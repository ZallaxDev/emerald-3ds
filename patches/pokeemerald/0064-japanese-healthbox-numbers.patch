Emerald 3DS changes to pret/pokeemerald 76463dac15cad36aca5e2b3f6366abf9e53f814f: The Japanese healthbox numbers and nickname in the bold font
Applies after 0005-port-hooks.patch; apply with tools/bootstrap.py.

diff --git a/src/battle_interface.c b/src/battle_interface.c
--- a/src/battle_interface.c
+++ b/src/battle_interface.c
@@ -1131,6 +1131,44 @@ void InitBattlerHealthboxCoords(u8 battler)
     UpdateSpritePos(gHealthboxSpriteIds[battler], x, y);
 }
 
+#if defined(PORT_BRIDGE) && GAME_LANGUAGE == LANGUAGE_JAPANESE
+// The Japanese game's healthbox numbers: its glyphs are 8 pixels wide, so it
+// draws them with the bold font in whole tiles (as UpdateHpTextInHealthbox's
+// other branch does), the level as two digits after the box's "Lv" tile.
+#define JAPANESE_HEALTHBOX_NUMBERS
+extern const u8 gText_EmptySpace2[]; // the space after a one-digit level
+static void UpdateLvlInHealthbox(u8 healthboxSpriteId, u8 lvl)
+{
+    u8 text[sizeof(sEmptyWhiteText_GrayHighlight)];
+    u32 tile, numTiles, i;
+    u8 battler = gSprites[healthboxSpriteId].hMain_Battler;
+
+    memcpy(text, sEmptyWhiteText_GrayHighlight, sizeof(text));
+    if (!IsDoubleBattle())
+        tile = GetBattlerSide(battler) == B_SIDE_PLAYER ? 0x49 : 0x28;
+    else
+        tile = GetBattlerSide(battler) == B_SIDE_PLAYER ? 0x29 : 0x28;
+    tile += gSprites[healthboxSpriteId].oam.tileNum;
+
+    if (lvl == MAX_LEVEL)
+    {
+        ConvertIntToDecimalStringN(text + 6, lvl, STR_CONV_MODE_LEFT_ALIGN, 3);
+        numTiles = 3;
+    }
+    else
+    {
+        CpuCopy32(GetHealthboxElementGfxPtr(HEALTHBOX_GFX_42), (void *)(OBJ_VRAM0 + tile * TILE_SIZE_4BPP), TILE_SIZE_4BPP);
+        ConvertIntToDecimalStringN(text + 6, lvl, STR_CONV_MODE_LEFT_ALIGN, 2);
+        if (lvl < 10)
+            StringCopy(text + 7, gText_EmptySpace2);
+        numTiles = 2;
+        tile++;
+    }
+    RenderTextHandleBold(gMonSpritesGfxPtr->barFontGfx, FONT_BOLD, text);
+    for (i = 0; i < numTiles; i++)
+        CpuCopy32(&gMonSpritesGfxPtr->barFontGfx[i * 64 + 32], (void *)(OBJ_VRAM0 + (tile + i) * TILE_SIZE_4BPP), TILE_SIZE_4BPP);
+}
+#else
 static void UpdateLvlInHealthbox(u8 healthboxSpriteId, u8 lvl)
 {
     u32 windowId, spriteTileNum;
@@ -1167,6 +1205,7 @@ static void UpdateLvlInHealthbox(u8 healthboxSpriteId, u8 lvl)
     TextIntoHealthboxObject(objVram, windowTileData, 3);
     RemoveWindowOnHealthbox(windowId);
 }
+#endif
 

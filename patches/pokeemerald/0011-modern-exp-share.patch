+#ifdef PLATFORM_3DS
+// Modern Exp Share (OPTIONS, ENHANCEMENTS): as in the later games, the whole
+// party shares - full EXP for who fought, half for the rest - and the rest
+// gain under one line. The held Exp. Share then adds nothing.
+enum
+{
+    EXP_SHARE_OFF,      // Exp share off
+    EXP_SHARE_GEN_VI,   // full EXP for each that fought, half for each of the rest
+    EXP_SHARE_BALANCED, // who fought split the full EXP, the rest split half of it
+};
+#define PARTY_EXP_SHARE_MODE() CtrExtras_Get("exp_share")
+#define PARTY_EXP_SHARE() (PARTY_EXP_SHARE_MODE() != EXP_SHARE_OFF)
+
+static bool8 sTeamExpShown;
+
+// Who the party share gives EXP to: not eggs, the fainted or those at Lv. 100.
+static bool8 ShouldGetPartyExp(struct Pokemon *mon)
+{
+    return GetMonData(mon, MON_DATA_SPECIES) != SPECIES_NONE
+        && !GetMonData(mon, MON_DATA_IS_EGG)
+        && GetMonData(mon, MON_DATA_HP) != 0
+        && GetMonData(mon, MON_DATA_LEVEL) != MAX_LEVEL;
+}
+
+// The party share's EXP, at least 1 each: *exp for each that fought,
+// gExpShareExp for each of the rest.
+static void SplitPartyExp(u16 calculatedExp, s32 sentIn, u16 *exp)
+{
+    s32 i, fought = 0, benched = 0;
+
+    switch (PARTY_EXP_SHARE_MODE())
+    {
+    case EXP_SHARE_BALANCED:
+        for (i = 0; i < PARTY_SIZE; i++)
+        {
+            if (!ShouldGetPartyExp(&gPlayerParty[i]))
+                continue;
+            if (gBitTable[i] & sentIn)
+                fought++;
+            else
+                benched++;
+        }
+        *exp = SAFE_DIV(calculatedExp, fought);
+        gExpShareExp = SAFE_DIV(calculatedExp / 2, benched);
+        break;
+    case EXP_SHARE_GEN_VI:
+    default:
+        *exp = calculatedExp;
+        gExpShareExp = calculatedExp / 2;
+        break;
+    }
+    if (*exp == 0)
+        *exp = 1;
+    if (gExpShareExp == 0)
+        gExpShareExp = 1;
+}
+#endif

Emerald 3DS changes to pret/pokeemerald 76463dac15cad36aca5e2b3f6366abf9e53f814f: balanced Exp Share
Applies after 0011-modern-exp-share.patch; apply with tools/bootstrap.py.

diff --git a/src/battle_script_commands.c b/src/battle_script_commands.c
--- a/src/battle_script_commands.c
+++ b/src/battle_script_commands.c
@@ -3268,6 +3268,18 @@
 // gain under one line. The held Exp. Share then adds nothing.
 static bool8 sTeamExpShown;
 #define PARTY_EXP_SHARE() (CtrExtras_Get("exp_share") != 0)
+// BALANCED (the option's third value): who fought split the full EXP and the
+// rest split half of it, leaving out eggs, the fainted and those at Lv. 100.
+#define PARTY_EXP_SHARE_BALANCED() (CtrExtras_Get("exp_share") == 2)
+
+// Who case 2 gives EXP to: this must match its skip and its Lv. 100 check.
+static bool8 GetsPartyExp(struct Pokemon *mon)
+{
+    return GetMonData(mon, MON_DATA_SPECIES) != SPECIES_NONE
+        && !GetMonData(mon, MON_DATA_IS_EGG)
+        && GetMonData(mon, MON_DATA_HP) != 0
+        && GetMonData(mon, MON_DATA_LEVEL) != MAX_LEVEL;
+}
 #endif
 

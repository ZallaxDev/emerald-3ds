+/* The look's ext palette: loaded if it is not, room made for it if need be. */
+static u8 LoadLookPalette(const struct NpcLook *look)
+{
+    u16 tag = look->info.paletteTag;
+    u8 slot = IndexOfSpritePaletteExtTag(tag);
+
+    if (slot != 0xFF)
+        return slot;
+    if (sNoRoomFrame == gMain.vblankCounter1 && !look->playerLook)
+        return 0xFF;
+    // The player's look always gets one: a person's is freed for it.
+    if (LooksLoaded() >= NPC_LOOK_PALETTES || gPlttExtInUse == (1u << PLTT_EXT_COUNT) - 1)
+    {
+        Collect();
+        if (LooksLoaded() >= NPC_LOOK_PALETTES && !look->playerLook)
+        {
+            sNoRoomFrame = gMain.vblankCounter1;
+            return 0xFF;
+        }
+    }
+    slot = LoadSpritePaletteExt(&(const struct SpritePalette){(const u16 *)(look->file + 8), tag});
+    if (slot == 0xFF)
+    {
+        sNoRoomFrame = gMain.vblankCounter1;
+        return 0xFF;
+    }
+    // Coming back to the field the weather is still in the fade-out that
+    // left it; there the field's own fade-in brings the colours in.
+    if (gMain.callback2 == CB2_Overworld)
+        UpdateSpritePaletteExtWithWeather(slot);
+    return slot;
+}
+
+/* The player's sheets not in the pack (or not right), by look: asked once. */
+static u16 sPlayerFailed[ARRAY_COUNT(sPlayerLooks) + 1];
+
+static const struct NpcLook *FindByTag(u16 tag)
+{
+    u32 i;
+
+    for (i = 0; i < sAllCount; i++)
+        if (sAll[i]->info.paletteTag == tag)
+            return sAll[i];
+    return NULL;
+}
+
+/* The player's picture `sheet` in the chosen look. */
+static const struct ObjectEventGraphicsInfo *PlayerGraphicsInfo(u16 graphicsId, const char *sheet,
+                                                                const struct ObjectEventGraphicsInfo *info)
+{
+    static const char *const sSheets[] = {"walk", "bike", "acroBike", "surf", "fieldMove", "underwater",
+                                          "fishing", "watering", "decorating"};
+    u32 look = PlayerLook(), sheetIndex = 0;
+    struct NpcLook *read;
+    char path[48];
+    u16 tag;
+
+    if (look == 0)
+        return NULL;
+    while (sheetIndex < ARRAY_COUNT(sSheets) - 1 && strcmp(sSheets[sheetIndex], sheet) != 0)
+        sheetIndex++;
+    tag = PLAYER_LOOK_PAL_TAG + look * 16 + sheetIndex;
+    if ((sPlayerFailed[look] >> sheetIndex) & 1)
+        return NULL;
+    if (sLooks[graphicsId] == NULL || sLooks[graphicsId]->playerLook != look)
+    {
+        const struct NpcLook *known = FindByTag(tag);
+
+        if (known != NULL)
+            sLooks[graphicsId] = (struct NpcLook *)known;
+        else
+        {
+            snprintf(path, sizeof(path), "players/%s/%s.bin", sPlayerLooks[look - 1], sheet);
+            read = Read(path, tag, (u8)look, info);
+            if (read == NULL)
+            {
+                sPlayerFailed[look] |= 1 << sheetIndex;
+                return NULL;
+            }
+            sLooks[graphicsId] = read;
+        }
+    }
+    if (LoadLookPalette(sLooks[graphicsId]) == 0xFF)
+        return NULL;
+    return &sLooks[graphicsId]->info;
+}
+
+const struct ObjectEventGraphicsInfo *NpcLook_GraphicsInfo(u16 graphicsId, const struct ObjectEventGraphicsInfo *info,
+                                                           bool8 standard)
+{
+    struct NpcLook *look;
+    const char *sheet;
+    char path[40];
+
+    if (graphicsId >= NUM_OBJ_EVENT_GFX)
+        return NULL;
+    if ((sheet = PlayerSheet(graphicsId)) != NULL)
+        return PlayerGraphicsInfo(graphicsId, sheet, info);
+    if (!standard || sState[graphicsId] == LOOK_NONE || !Enabled())
+        return NULL;
+    if (info->paletteSlot == PALSLOT_PLAYER || info->width != 16 || (info->height != 32 && info->height != 16))
+        return NULL;
+    look = sLooks[graphicsId];
+    if (sState[graphicsId] != LOOK_READ)
+    {
+        sState[graphicsId] = LOOK_NONE;
+        if (sNames[graphicsId] == NULL)
+            return NULL;
+        snprintf(path, sizeof(path), "npcs/%s.bin", sNames[graphicsId]);
+        if ((look = Read(path, NPC_LOOK_PAL_TAG + graphicsId, 0, info)) == NULL)
+            return NULL;
+        sLooks[graphicsId] = look;
+        sState[graphicsId] = LOOK_READ;
+    }
+    if (LoadLookPalette(look) == 0xFF)
+        return NULL;
+    return &look->info;
+}
+
+void NpcLook_BindSprite(const struct ObjectEventGraphicsInfo *info, struct Sprite *sprite)
+{
+    const struct NpcLook *look;
+    u8 ext;
+    u32 i;
+
+    if (NpcLook_IsLook(info) && (look = FindByTag(info->paletteTag)) != NULL)
+    {
+        SetSpriteExtPalette(sprite, LoadLookPalette(look));
+        return;
+    }
+    /* Back to the game's own (a script or the player's state changed its
+     * graphics): off a look's ext palette. */
+    if ((ext = GetSpriteExtPalette(sprite)) == 0xFF)
+        return;
+    for (i = 0; i < sAllCount; i++)
+        if (IndexOfSpritePaletteExtTag(sAll[i]->info.paletteTag) == ext)
+        {
+            SetSpriteExtPalette(sprite, 0xFF);
+            break;
+        }
+}
+
+bool8 NpcLook_PlayerBackPic(void *dest, u16 paletteOffset)
+{
+    u32 look = PlayerLook(), size;
+    char path[48];
+    u8 *file;
+
+    if (look == 0)
+        return FALSE;
+    snprintf(path, sizeof(path), "players/%s/back.bin", sPlayerLooks[look - 1]);
+    if (!CtrData_Exists(path) || (file = CtrData_Load(path, &size)) == NULL)
+        return FALSE;
+    if (size < NPL_HEADER + 4 * 64 * 64 / 2 || memcmp(file, "NPL1", 4) != 0 || file[4] != 4
+     || file[5] != 64 || file[6] != 64)
+    {
+        free(file);
+        return FALSE;
+    }
+    memcpy(dest, file + NPL_HEADER, 4 * 64 * 64 / 2);
+    LoadPalette(file + 8, paletteOffset, PLTT_SIZE_4BPP);
+    free(file);
+    return TRUE;
+}
+
+void NpcLook_ReleaseAll(void)
+{
+    u32 i;
+
+    for (i = 0; i < sAllCount; i++)
+    {
+        free(sAll[i]->file);
+        free(sAll[i]);
+        sAll[i] = NULL;
+    }
+    sAllCount = 0;
+    memset(sPlayerFailed, 0, sizeof(sPlayerFailed));
+    for (i = 0; i < NUM_OBJ_EVENT_GFX; i++)
+    {
+        sLooks[i] = NULL;
+        sState[i] = LOOK_UNKNOWN;
+    }
+}
+#endif

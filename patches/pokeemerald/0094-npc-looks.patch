Applies after 0093-bw-animated-battlers.patch; apply with tools/bootstrap.py.

diff --git a/include/npc_looks.h b/include/npc_looks.h
new file mode 100644
index 0000000..aadbe6d
--- /dev/null
+++ b/include/npc_looks.h
@@ -0,0 +1,35 @@
+#ifndef GUARD_NPC_LOOKS_H
+#define GUARD_NPC_LOOKS_H
+
+#ifdef PLATFORM_3DS
+/*
+ * Port: new looks for the field's people (OPTIONS > GRAPHICS > NEW PEOPLE) and
+ * for the player (OPTIONS > GRAPHICS > PLAYER), from the npcs/NAME.bin and
+ * players/LOOK/SHEET.bin files the builder puts in the data pack
+ * (builder/emerald3ds_builder/npc_looks.py: Facets' DS-style sets, Emerald
+ * Lens' looks). A person
+ * with one is a 32x32 sprite of its own frames, on an ext palette of its own
+ * (include/palette.h); without one, or with no ext palette to spare, the
+ * game's own.
+ */
+struct ObjectEventGraphicsInfo;
+struct Sprite;
+
+/* The look standing in for `info` (graphics id `graphicsId`, a person on the
+ * standard nine frames or the nurse's when `standard`), or NULL for the
+ * game's own. */
+const struct ObjectEventGraphicsInfo *NpcLook_GraphicsInfo(u16 graphicsId, const struct ObjectEventGraphicsInfo *info,
+                                                           bool8 standard);
+/* A sprite just made (or remade) from `info`: on its look's ext palette, or
+ * off any if `info` is not a look. */
+void NpcLook_BindSprite(const struct ObjectEventGraphicsInfo *info, struct Sprite *sprite);
+bool8 NpcLook_IsLook(const struct ObjectEventGraphicsInfo *info);
+/* The battle's back picture of the player in the chosen look, where it has
+ * one: its four 64x64 frames (standing, then the throw) into `dest` and its
+ * colours at palette buffer offset `paletteOffset`. FALSE: the game's. */
+bool8 NpcLook_PlayerBackPic(void *dest, u16 paletteOffset);
+/* The soft reset: every file freed. */
+void NpcLook_ReleaseAll(void);
+#endif
+
+#endif // GUARD_NPC_LOOKS_H

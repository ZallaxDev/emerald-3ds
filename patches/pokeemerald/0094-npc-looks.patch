+
+/* The two options, read once a frame: the field asks for graphics often. */
+static u32 sOptionsFrame = 0xFFFFFFFF;
+static bool8 sEnabled;
+static u8 sPlayerLook;
+
+static void ReadOptions(void)
+{
+    u32 look;
+
+    if (sOptionsFrame == gMain.vblankCounter1)
+        return;
+    sOptionsFrame = gMain.vblankCounter1;
+    sEnabled = CtrExtras_Get("npc_looks") != 0;
+    look = CtrExtras_Get("player_look");
+    sPlayerLook = look <= ARRAY_COUNT(sPlayerLooks) ? look : 0;
+}
+
+static bool8 Enabled(void)
+{
+    ReadOptions();
+    return sEnabled;
+}
+
+static u32 PlayerLook(void)
+{
+    ReadOptions();
+    return sPlayerLook;
+}
+
+static bool8 IsLookTag(u16 tag)
+{
+    return (tag >= NPC_LOOK_PAL_TAG && tag < NPC_LOOK_PAL_TAG + NUM_OBJ_EVENT_GFX)
+        || (tag >= PLAYER_LOOK_PAL_TAG && tag < PLAYER_LOOK_PAL_TAG + 16 * (ARRAY_COUNT(sPlayerLooks) + 1));
+}
+
+bool8 NpcLook_IsLook(const struct ObjectEventGraphicsInfo *info)
+{
+    return info != NULL && IsLookTag(info->paletteTag);
+}
+
+/* A look's file read and its graphics info built over the game's. */
+static struct NpcLook *Read(const char *path, u16 tag, u8 playerLook, const struct ObjectEventGraphicsInfo *base)
+{
+    struct NpcLook *look;
+    u8 *file;
+    u32 size, i, frames;
+
+    if (sAllCount >= MAX_LOOKS || !CtrData_Exists(path) || (file = CtrData_Load(path, &size)) == NULL)
+        return NULL;
+    frames = file[4];
+    if (size < NPL_HEADER + frames * NPL_FRAME_BYTES || memcmp(file, "NPL1", 4) != 0
+     || frames == 0 || frames > NPL_FRAMES_MAX || file[5] != NPL_SIZE || file[6] != NPL_SIZE
+     || (look = calloc(1, sizeof(*look))) == NULL)
+    {
+        CtrLog_Write(CTR_LOG_ERROR, "npc looks: %s is not a look", path);
+        free(file);
+        return NULL;
+    }
+    look->file = file;
+    look->playerLook = playerLook;
+    for (i = 0; i < LOOK_IMAGES; i++)
+    {
+        look->frames[i].data = file + NPL_HEADER + (i < frames ? i : 0) * NPL_FRAME_BYTES;
+        look->frames[i].size = NPL_FRAME_BYTES;
+        look->frames[i].offset = 0;
+    }
+    look->info = *base;
+    look->info.tileTag = TAG_NONE;
+    look->info.paletteTag = tag;
+    look->info.reflectionPaletteTag = OBJ_EVENT_PAL_TAG_NONE;
+    look->info.size = NPL_FRAME_BYTES;
+    look->info.width = NPL_SIZE;
+    look->info.height = NPL_SIZE;
+    look->info.paletteSlot = PALSLOT_NPC_1;   /* PLTT_EXT_MODEL: the weather's rule for ext palettes */
+    look->info.disableReflectionPaletteLoad = TRUE;
+    look->info.oam = &gObjectEventBaseOam_32x32;
+    look->info.subspriteTables = ObjectEventSubspriteTables(NPL_SIZE);
+    look->info.images = look->frames;
+    sAll[sAllCount++] = look;
+    return look;
+}
+
+/* The looks' ext palettes no sprite shows any more, freed. */
+static void Collect(void)
+{
+    u32 inUse = 0, i;
+
+    for (i = 0; i < MAX_SPRITES; i++)
+    {
+        u8 ext;
+
+        if (!gSprites[i].inUse || (ext = GetSpriteExtPalette(&gSprites[i])) == 0xFF)
+            continue;
+        inUse |= 1u << ext;
+    }
+    for (i = 0; i < sAllCount; i++)
+    {
+        u16 tag = sAll[i]->info.paletteTag;
+        u8 slot = IndexOfSpritePaletteExtTag(tag);
+
+        if (slot != 0xFF && !((inUse >> slot) & 1))
+            FreeSpritePaletteByTag(tag);
+    }
+}
+
+static u32 LooksLoaded(void)
+{
+    u32 count = 0, i;
+
+    for (i = 0; i < sAllCount; i++)
+        if (IndexOfSpritePaletteExtTag(sAll[i]->info.paletteTag) != 0xFF)
+            count++;
+    return count;
+}

diff --git a/src/item_use.c b/src/item_use.c
--- a/src/item_use.c
+++ b/src/item_use.c
@@ -1260,3 +1260,210 @@
 }
 
 #undef tUsingRegisteredKeyItem
+
+#ifdef PORT_BRIDGE
+#include "battle_pike.h"
+#include "bg.h"
+#include "field_specials.h"
+#include "link.h"
+#include "map_name_popup.h"
+
+/*
+ * USE from the bottom screen's bag (3ds_bottom_ui.c), without the bag's own
+ * screen: what ItemMenu_UseOutOfBattle and the item's field function would
+ * do. An item used on a Pokémon is the bottom screen's party's (party_menu.c,
+ * CtrParty_UseItem); one used on the field runs there as a registered item
+ * does from SELECT (UseRegisteredKeyItemOnField), with the field's messages;
+ * the bag's own messages come back in `text`. The string buffers are left as
+ * they were.
+ */
+static u8 sCtrVars[3][sizeof(gStringVar1)], sCtrVar4[sizeof(gStringVar4)];
+
+static void CtrSaveStringVars(void)
+{
+    memcpy(sCtrVars[0], gStringVar1, sizeof(gStringVar1));
+    memcpy(sCtrVars[1], gStringVar2, sizeof(gStringVar2));
+    memcpy(sCtrVars[2], gStringVar3, sizeof(gStringVar3));
+    memcpy(sCtrVar4, gStringVar4, sizeof(gStringVar4));
+}
+
+// gStringVar4 into `text`, then the buffers as they were.
+static void CtrRestoreStringVars(u8 *text, u32 size)
+{
+    u32 i;
+
+    for (i = 0; i + 1 < size && gStringVar4[i] != EOS; i++)
+        text[i] = gStringVar4[i];
+    text[i] = EOS;
+    memcpy(gStringVar1, sCtrVars[0], sizeof(gStringVar1));
+    memcpy(gStringVar2, sCtrVars[1], sizeof(gStringVar2));
+    memcpy(gStringVar3, sCtrVars[2], sizeof(gStringVar3));
+    memcpy(gStringVar4, sCtrVar4, sizeof(gStringVar4));
+}
+
+// The field function, the ENIGMA BERRY's by its effect (ItemUseOutOfBattle_EnigmaBerry).
+TaskFunc CtrItem_FieldFunc(u16 item)
+{
+    TaskFunc func = GetItemFieldFunc(item);
+
+    if (func != ItemUseOutOfBattle_EnigmaBerry)
+        return func;
+    switch (GetItemEffectType(item))
+    {
+    case ITEM_EFFECT_HEAL_HP:
+    case ITEM_EFFECT_CURE_POISON:
+    case ITEM_EFFECT_CURE_SLEEP:
+    case ITEM_EFFECT_CURE_BURN:
+    case ITEM_EFFECT_CURE_FREEZE:
+    case ITEM_EFFECT_CURE_PARALYSIS:
+    case ITEM_EFFECT_CURE_ALL_STATUS:
+    case ITEM_EFFECT_ATK_EV:
+    case ITEM_EFFECT_HP_EV:
+    case ITEM_EFFECT_SPATK_EV:
+    case ITEM_EFFECT_SPDEF_EV:
+    case ITEM_EFFECT_SPEED_EV:
+    case ITEM_EFFECT_DEF_EV:
+        return ItemUseOutOfBattle_Medicine;
+    case ITEM_EFFECT_SACRED_ASH:
+        return ItemUseOutOfBattle_SacredAsh;
+    case ITEM_EFFECT_RAISE_LEVEL:
+        return ItemUseOutOfBattle_RareCandy;
+    case ITEM_EFFECT_PP_UP:
+    case ITEM_EFFECT_PP_MAX:
+        return ItemUseOutOfBattle_PPUp;
+    case ITEM_EFFECT_HEAL_PP:
+        return ItemUseOutOfBattle_PPRecovery;
+    }
+    return ItemUseOutOfBattle_CannotUse;
+}
+
+// ItemUseOutOfBattle_TMHM's messages, one page after the other.
+void CtrBag_TMHMText(u16 item, u8 *text, u32 size)
+{
+    u8 *end;
+
+    CtrSaveStringVars();
+    end = StringCopy(gStringVar4, item >= ITEM_HM01 ? gText_BootedUpHM : gText_BootedUpTM);
+    *end++ = CHAR_PROMPT_CLEAR;
+    StringCopy(gStringVar1, gMoveNames[ItemIdToBattleMoveId(item)]);
+    StringExpandPlaceholders(end, gText_TMHMContainedVar1);
+    CtrRestoreStringVars(text, size);
+    PlaySE(SE_PC_LOGIN);
+}
+
+u8 CtrBag_UseItem(u16 item, bool8 berriesPocket, u8 *text, u32 size, u8 *slot)
+{
+    TaskFunc func = CtrItem_FieldFunc(item);
+    u8 taskId, result = CTR_BAG_USE_MESSAGE;
+
+    text[0] = EOS;
+    if (func == NULL)
+        return CTR_BAG_USE_NONE;
+    // ItemUseOutOfBattle_Berry: planted where the player faces soil.
+    if (berriesPocket && IsPlayerFacingEmptyBerryTreePatch() == TRUE)
+    {
+        gSpecialVar_ItemId = item;
+        CreateTask(ItemUseOnFieldCB_Berry, 8);
+        return CTR_BAG_USE_FIELD;
+    }
+    if (func == ItemUseOutOfBattle_Mail)
+        return CTR_BAG_USE_MAIL;
+    if (func == ItemUseOutOfBattle_Medicine || func == ItemUseOutOfBattle_ReduceEV
+     || func == ItemUseOutOfBattle_SacredAsh || func == ItemUseOutOfBattle_PPRecovery
+     || func == ItemUseOutOfBattle_PPUp || func == ItemUseOutOfBattle_RareCandy
+     || func == ItemUseOutOfBattle_TMHM || func == ItemUseOutOfBattle_EvolutionStone)
+    {
+        if (CalculatePlayerPartyCount() == 0)
+        {
+            StringCopy(text, gText_NoPokemon);
+            return CTR_BAG_USE_MESSAGE;
+        }
+        if (func == ItemUseOutOfBattle_SacredAsh)
+            return CTR_BAG_USE_SACRED_ASH;
+        if (func != ItemUseOutOfBattle_TMHM)
+            return CTR_BAG_USE_PARTY;
+#ifdef PLATFORM_3DS
+        if (CanUseFieldHmFromBag(item))
+        {
+            CtrSaveStringVars();
+            *slot = FieldHmUser(ItemIdToBattleMoveId(item));
+            StringCopy(gStringVar1, gMoveNames[ItemIdToBattleMoveId(item)]);
+            StringExpandPlaceholders(gStringVar4, sText_UseFieldHmNow);
+            CtrRestoreStringVars(text, size);
+            return CTR_BAG_USE_FIELD_HM;
+        }
+#endif
+        CtrBag_TMHMText(item, text, size);
+        return CTR_BAG_USE_TMHM;
+    }
+
+    CtrSaveStringVars();
+    gSpecialVar_ItemId = item;
+    if (func == ItemUseOutOfBattle_Repel)
+    {
+        // Task_UseRepel's, at once.
+        if (VarGet(VAR_REPEL_STEP_COUNT) == 0)
+        {
+            PlaySE(SE_REPEL);
+            VarSet(VAR_REPEL_STEP_COUNT, GetItemHoldEffectParam(item));
+#ifdef PLATFORM_3DS
+            VarSet(VAR_LAST_REPEL, item);
+#endif
+            RemoveBagItem(item, 1);
+            CopyItemName(item, gStringVar2);
+            StringExpandPlaceholders(gStringVar4, gText_PlayerUsedVar2);
+        }
+        else
+        {
+            StringExpandPlaceholders(gStringVar4, gText_RepelEffectsLingered);
+        }
+    }
+    else if (func == ItemUseOutOfBattle_BlackWhiteFlute)
+    {
+        CopyItemName(item, gStringVar2);
+        if (item == ITEM_WHITE_FLUTE)
+        {
+            FlagSet(FLAG_SYS_ENC_UP_ITEM);
+            FlagClear(FLAG_SYS_ENC_DOWN_ITEM);
+            StringExpandPlaceholders(gStringVar4, gText_UsedVar2WildLured);
+        }
+        else
+        {
+            FlagSet(FLAG_SYS_ENC_DOWN_ITEM);
+            FlagClear(FLAG_SYS_ENC_UP_ITEM);
+            StringExpandPlaceholders(gStringVar4, gText_UsedVar2WildRepelled);
+        }
+        PlaySE(SE_GLASS_FLUTE);
+    }
+    else if (func == ItemUseOutOfBattle_CoinCase)
+    {
+        ConvertIntToDecimalStringN(gStringVar1, GetCoins(), STR_CONV_MODE_LEFT_ALIGN, 4);
+        StringExpandPlaceholders(gStringVar4, gText_CoinCase);
+    }
+    else if (func == ItemUseOutOfBattle_PowderJar)
+    {
+        ConvertIntToDecimalStringN(gStringVar1, GetBerryPowder(), STR_CONV_MODE_LEFT_ALIGN, 5);
+        StringExpandPlaceholders(gStringVar4, gText_PowderQty);
+    }
+    else if (func == ItemUseOutOfBattle_CannotUse || InUnionRoom() == TRUE
+          || CurrentBattlePyramidLocation() != PYRAMID_LOCATION_NONE || InBattlePike() || InMultiPartnerRoom() == TRUE)
+    {
+        StringExpandPlaceholders(gStringVar4, gText_DadsAdvice);
+    }
+    else
+    {
+        // UseRegisteredKeyItemOnField, for this item.
+        HideMapNamePopUpWindow();
+        ChangeBgY_ScreenOff(0, 0, BG_COORD_SET);
+        LockPlayerFieldControls();
+        FreezeObjectEvents();
+        PlayerFreeze();
+        StopPlayerAvatar();
+        taskId = CreateTask(func, 8);
+        gTasks[taskId].data[3] = TRUE; // tUsingRegisteredKeyItem
+        result = CTR_BAG_USE_FIELD;
+    }
+    CtrRestoreStringVars(text, size);
+    return result;
+}
+#endif

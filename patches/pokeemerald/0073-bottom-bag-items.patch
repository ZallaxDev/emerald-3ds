+#ifdef PORT_BRIDGE
+/*
+ * Items used on a Pokémon from the bottom screen's bag (3ds_bottom_ui.c),
+ * without this menu: what the ItemUseCB_* functions do, their messages back in
+ * `text` (the string buffers left as they were). The bottom screen asks for a
+ * move, shows the level-up stats and goes through learning a move; the
+ * evolution scene, an event, takes the screens as it does from here.
+ */
+static u8 sCtrItemVars[3][sizeof(gStringVar1)], sCtrItemVar4[sizeof(gStringVar4)];
+
+static void CtrItemSaveVars(void)
+{
+    memcpy(sCtrItemVars[0], gStringVar1, sizeof(gStringVar1));
+    memcpy(sCtrItemVars[1], gStringVar2, sizeof(gStringVar2));
+    memcpy(sCtrItemVars[2], gStringVar3, sizeof(gStringVar3));
+    memcpy(sCtrItemVar4, gStringVar4, sizeof(gStringVar4));
+}
+
+static void CtrItemRestoreVars(u8 *text, u32 size)
+{
+    CtrCopyTextBounded(text, gStringVar4, size);
+    memcpy(gStringVar1, sCtrItemVars[0], sizeof(gStringVar1));
+    memcpy(gStringVar2, sCtrItemVars[1], sizeof(gStringVar2));
+    memcpy(gStringVar3, sCtrItemVars[2], sizeof(gStringVar3));
+    memcpy(gStringVar4, sCtrItemVar4, sizeof(gStringVar4));
+}
+
+static struct { u8 slot; u16 species; bool8 canStop; } sCtrEvolution;
+
+static void Task_CtrBeginEvolution(u8 taskId)
+{
+    if (!gPaletteFade.active)
+    {
+        DestroyTask(taskId);
+        CleanupOverworldWindowsAndTilemaps();
+        gCB2_AfterEvolution = CB2_ReturnToField;
+        BeginEvolutionScene(&gPlayerParty[sCtrEvolution.slot], sCtrEvolution.species, sCtrEvolution.canStop,
+                            sCtrEvolution.slot);
+    }
+}
+
+static void CtrStartEvolution(u8 slot, u16 species, bool8 canStop)
+{
+    sCtrEvolution.slot = slot;
+    sCtrEvolution.species = species;
+    sCtrEvolution.canStop = canStop;
+    LockPlayerFieldControls();
+    FadeScreen(FADE_TO_BLACK, 0);
+    CreateTask(Task_CtrBeginEvolution, 8);
+}
+
+// DisplayPartyMenuStdMessage's text for a slot (TMs: ABLE, NOT ABLE,
+// LEARNED; stones: NO USE), or NULL for its HP as ever.
+const u8 *CtrParty_ItemDescText(u8 slot, u16 item)
+{
+    struct Pokemon *mon = &gPlayerParty[slot];
+
+    switch (CheckIfItemIsTMHMOrEvolutionStone(item))
+    {
+    case 1:
+        switch (CanMonLearnTMTutor(mon, item, 0))
+        {
+        case CANNOT_LEARN_MOVE:
+        case CANNOT_LEARN_MOVE_IS_EGG:
+            return sDescriptionStringTable[PARTYBOX_DESC_NOT_ABLE_2];
+        case ALREADY_KNOWS_MOVE:
+            return sDescriptionStringTable[PARTYBOX_DESC_LEARNED];
+        }
+        return sDescriptionStringTable[PARTYBOX_DESC_ABLE_2];
+    case 2:
+        if (!GetMonData(mon, MON_DATA_IS_EGG) && GetEvolutionTargetSpecies(mon, EVO_MODE_ITEM_CHECK, item) != SPECIES_NONE)
+            return NULL;
+        return sDescriptionStringTable[PARTYBOX_DESC_NO_USE];
+    }
+    return NULL;
+}
+
+static u8 CtrItemNoEffect(u8 *text, u32 size)
+{
+    PlaySE(SE_SELECT);
+    CtrCopyTextBounded(text, gText_WontHaveEffect, size);
+    return CTR_ITEM_NO_EFFECT;
+}
+
+// TryUsePPItem.
+static u8 CtrUsePPItem(u8 slot, u16 item, u8 moveSlot, u8 *text, u32 size)
+{
+    if (ExecuteTableBasedItemEffect_(slot, item, moveSlot))
+        return CtrItemNoEffect(text, size);
+    PlaySE(SE_USE_ITEM);
+    RemoveBagItem(item, 1);
+    CtrItemSaveVars();
+    StringCopy(gStringVar1, gMoveNames[GetMonData(&gPlayerParty[slot], MON_DATA_MOVE1 + moveSlot)]);
+    GetMedicineItemEffectMessage(item);
+    CtrItemRestoreVars(text, size);
+    return CTR_ITEM_DONE;
+}
+
+u8 CtrParty_UseItem(u8 slot, u16 item, u8 moveSlot, u8 *text, u32 size, s16 *stats, u16 *move)
+{
+    struct Pokemon *mon = &gPlayerParty[slot];
+    TaskFunc func = CtrItem_FieldFunc(item);
+    const u8 *effect = item == ITEM_ENIGMA_BERRY ? gSaveBlock1Ptr->enigmaBerry.itemEffect : gItemEffectTable[item - ITEM_POTION];
+    u16 hp, species;
+    u8 result = CTR_ITEM_DONE;
+
+    text[0] = EOS;
+    gPartyMenu.slotId = slot;
+    if (func == ItemUseOutOfBattle_Medicine)
+    {
+        bool8 canHeal = FALSE;
+
+        hp = GetMonData(mon, MON_DATA_HP);
+        if (NotUsingHPEVItemOnShedinja(mon, item) == FALSE)
+            return CtrItemNoEffect(text, size);
+        canHeal = IsHPRecoveryItem(item) && hp != GetMonData(mon, MON_DATA_MAX_HP);
+        if (ExecuteTableBasedItemEffect_(slot, item, 0))
+            return CtrItemNoEffect(text, size);
+        if (!IsItemFlute(item))
+        {
+            PlaySE(SE_USE_ITEM);
+            RemoveBagItem(item, 1);
+        }
+        else
+        {
+            PlaySE(SE_GLASS_FLUTE);
+        }
+        CtrItemSaveVars();
+        GetMonNickname(mon, gStringVar1);
+        if (canHeal)
+        {
+            ConvertIntToDecimalStringN(gStringVar2, GetMonData(mon, MON_DATA_HP) - hp, STR_CONV_MODE_LEFT_ALIGN, 3);
+            StringExpandPlaceholders(gStringVar4, gText_PkmnHPRestoredByVar2);
+        }
+        else
+        {
+            GetMedicineItemEffectMessage(item);
+        }
+        CtrItemRestoreVars(text, size);
+    }
+    else if (func == ItemUseOutOfBattle_ReduceEV)
+    {
+        u8 effectType = GetItemEffectType(item);
+        u16 friendship = GetMonData(mon, MON_DATA_FRIENDSHIP), ev = ItemEffectToMonEv(mon, effectType);
+        bool8 cannotUse = ExecuteTableBasedItemEffect_(slot, item, 0);
+        u16 newFriendship = GetMonData(mon, MON_DATA_FRIENDSHIP), newEv = ItemEffectToMonEv(mon, effectType);
+
+        if (cannotUse || (friendship == newFriendship && ev == newEv))
+            return CtrItemNoEffect(text, size);
+        PlaySE(SE_USE_ITEM);
+        RemoveBagItem(item, 1);
+        CtrItemSaveVars();
+        GetMonNickname(mon, gStringVar1);
+        ItemEffectToStatString(effectType, gStringVar2);
+        if (friendship != newFriendship)
+            StringExpandPlaceholders(gStringVar4, ev != newEv ? gText_PkmnFriendlyBaseVar2Fell : gText_PkmnFriendlyBaseVar2CantFall);
+        else
+            StringExpandPlaceholders(gStringVar4, gText_PkmnAdoresBaseVar2Fell);
+        CtrItemRestoreVars(text, size);
+    }
+    else if (func == ItemUseOutOfBattle_PPRecovery || func == ItemUseOutOfBattle_PPUp)
+    {
+        bool8 oneMove = func == ItemUseOutOfBattle_PPUp || (effect[4] & ITEM4_HEAL_PP_ONE);
+
+        if (oneMove && moveSlot >= MAX_MON_MOVES)
+        {
+            PlaySE(SE_SELECT);
+            CtrCopyTextBounded(text, sActionStringTable[func == ItemUseOutOfBattle_PPUp ? PARTY_MSG_BOOST_PP_WHICH_MOVE
+                                                                                         : PARTY_MSG_RESTORE_WHICH_MOVE], size);
+            return CTR_ITEM_PICK_MOVE;
+        }
+        return CtrUsePPItem(slot, item, oneMove ? moveSlot : 0, text, size);
+    }
+    else if (func == ItemUseOutOfBattle_RareCandy)
+    {
+        if (GetMonData(mon, MON_DATA_LEVEL) == MAX_LEVEL)
+            return CtrItemNoEffect(text, size);
+        BufferMonStatsToTaskData(mon, stats);
+        if (ExecuteTableBasedItemEffect_(slot, item, 0))
+            return CtrItemNoEffect(text, size);
+        BufferMonStatsToTaskData(mon, &stats[NUM_STATS]);
+        PlaySE(SE_SELECT);
+        PlayFanfareByFanfareNum(FANFARE_LEVEL_UP);
+        RemoveBagItem(item, 1);
+        CtrItemSaveVars();
+        GetMonNickname(mon, gStringVar1);
+        ConvertIntToDecimalStringN(gStringVar2, GetMonData(mon, MON_DATA_LEVEL), STR_CONV_MODE_LEFT_ALIGN, 3);
+        StringExpandPlaceholders(gStringVar4, gText_PkmnElevatedToLvVar2);
+        CtrItemRestoreVars(text, size);
+        result = CTR_ITEM_LEVEL_UP;
+    }
+    else if (func == ItemUseOutOfBattle_EvolutionStone)
+    {
+        // ExecuteTableBasedItemEffect's ITEM4_EVO_STONE, from the field.
+        species = GetMonData(mon, MON_DATA_IS_EGG) ? SPECIES_NONE : GetEvolutionTargetSpecies(mon, EVO_MODE_ITEM_USE, item);
+        if (species == SPECIES_NONE)
+            return CtrItemNoEffect(text, size);
+        PlaySE(SE_SELECT);
+        RemoveBagItem(item, 1);
+        CtrStartEvolution(slot, species, FALSE);
+        result = CTR_ITEM_EVOLVING;
+    }
+    else if (func == ItemUseOutOfBattle_TMHM)
+    {
+        // ItemUseCB_TMHM and Task_LearnedMove.
+        PlaySE(SE_SELECT);
+        *move = ItemIdToBattleMoveId(item);
+        CtrItemSaveVars();
+        GetMonNickname(mon, gStringVar1);
+        StringCopy(gStringVar2, gMoveNames[*move]);
+        switch (CanMonLearnTMTutor(mon, item, 0))
+        {
+        case CANNOT_LEARN_MOVE:
+        case CANNOT_LEARN_MOVE_IS_EGG:
+            StringExpandPlaceholders(gStringVar4, gText_PkmnCantLearnMove);
+            break;
+        case ALREADY_KNOWS_MOVE:
+            StringExpandPlaceholders(gStringVar4, gText_PkmnAlreadyKnows);
+            break;
+        default:
+            if (GiveMoveToMon(mon, *move) != MON_HAS_MAX_MOVES)
+            {
+                AdjustFriendship(mon, FRIENDSHIP_EVENT_LEARN_TMHM);
+#ifdef PLATFORM_3DS
+                if (item < ITEM_HM01 && !CtrExtras_Get("infinite_tms"))
+#else
+                if (item < ITEM_HM01)
+#endif
+                    RemoveBagItem(item, 1);
+                StringExpandPlaceholders(gStringVar4, gText_PkmnLearnedMove3);
+                PlayFanfare(MUS_LEVEL_UP);
+                result = CTR_ITEM_LEARNED;
+            }
+            else
+            {
+                StringExpandPlaceholders(gStringVar4, gText_PkmnNeedsToReplaceMove);
+                result = CTR_ITEM_REPLACE;
+            }
+            break;
+        }
+        CtrItemRestoreVars(text, size);
+    }
+    else
+    {
+        return CtrItemNoEffect(text, size);
+    }
+    return result;
 }
+
+// ItemUseCB_SacredAsh and Task_SacredAshLoop: every fainted Pokémon, a page each.
+u8 CtrParty_SacredAsh(u16 item, u8 *text, u32 size)
+{
+    u8 i, *end;
+    u16 hp;
+    bool8 hadEffect = FALSE;
+
+    CtrItemSaveVars();
+    end = gStringVar4;
+    *end = EOS;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        struct Pokemon *mon = &gPlayerParty[i];
+
+        if (GetMonData(mon, MON_DATA_SPECIES) == SPECIES_NONE)
+            continue;
+        hp = GetMonData(mon, MON_DATA_HP);
+        if (ExecuteTableBasedItemEffect_(i, item, 0))
+            continue;
+        if (hadEffect)
+            *end++ = CHAR_PROMPT_CLEAR;
+        hadEffect = TRUE;
+        GetMonNickname(mon, gStringVar1);
+        ConvertIntToDecimalStringN(gStringVar2, GetMonData(mon, MON_DATA_HP) - hp, STR_CONV_MODE_LEFT_ALIGN, 3);
+        end = StringExpandPlaceholders(end, gText_PkmnHPRestoredByVar2);
+    }
+    CtrItemRestoreVars(text, size);
+    if (!hadEffect)
+        return CtrItemNoEffect(text, size);
+    PlaySE(SE_USE_ITEM);
+    RemoveBagItem(item, 1);
+    return CTR_ITEM_DONE;
+}
+
+// Task_TryLearnNewMoves and Task_TryLearningNextMove: the next move the new
+// level teaches, learned, to be made room for, or none left.
+u8 CtrParty_LevelUpMove(u8 slot, bool8 first, u8 *text, u32 size, u16 *move)
+{
+    struct Pokemon *mon = &gPlayerParty[slot];
+    u16 result = MonTryLearningNewMove(mon, first);
+
+    while (result == MON_ALREADY_KNOWS_MOVE)
+        result = MonTryLearningNewMove(mon, FALSE);
+    if (result == 0)
+        return CTR_ITEM_NO_MORE;
+    *move = result == MON_HAS_MAX_MOVES ? gMoveToLearn : result;
+    CtrItemSaveVars();
+    GetMonNickname(mon, gStringVar1);
+    StringCopy(gStringVar2, gMoveNames[*move]);
+    if (result == MON_HAS_MAX_MOVES)
+    {
+        StringExpandPlaceholders(gStringVar4, gText_PkmnNeedsToReplaceMove);
+        CtrItemRestoreVars(text, size);
+        return CTR_ITEM_REPLACE;
+    }
+    StringExpandPlaceholders(gStringVar4, gText_PkmnLearnedMove3);
+    CtrItemRestoreVars(text, size);
+    PlayFanfare(MUS_LEVEL_UP);
+    return CTR_ITEM_LEARNED;
+}
+
+// Task_PartyMenuReplaceMove, then Task_LearnedMove's for a TM. An HM's move
+// can't be forgotten (CanReplaceMove): FALSE.
+bool8 CtrParty_ReplaceMove(u8 slot, u8 moveSlot, u16 move, u16 tmItem)
+{
+    struct Pokemon *mon = &gPlayerParty[slot];
+
+    if (IsMoveHm(GetMonData(mon, MON_DATA_MOVE1 + moveSlot)))
+        return FALSE;
+    RemoveMonPPBonus(mon, moveSlot);
+    SetMonMoveSlot(mon, move, moveSlot);
+    if (tmItem != ITEM_NONE)
+    {
+        AdjustFriendship(mon, FRIENDSHIP_EVENT_LEARN_TMHM);
+#ifdef PLATFORM_3DS
+        if (tmItem < ITEM_HM01 && !CtrExtras_Get("infinite_tms"))
+#else
+        if (tmItem < ITEM_HM01)
 #endif
+            RemoveBagItem(tmItem, 1);
+    }
+    PlayFanfare(MUS_LEVEL_UP);
+    return TRUE;
+}

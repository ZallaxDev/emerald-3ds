@@ -0,0 +1,1612 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "global.h"
+#ifdef PLATFORM_3DS
+#include "3ds_data.h"
+#include "3ds_daynight.h"

+static const char *LanguageCode(void)
+{
+#if GAME_LANGUAGE == LANGUAGE_SPANISH
+    return "es";
+#elif GAME_LANGUAGE == LANGUAGE_FRENCH
+    return "fr";
+#elif GAME_LANGUAGE == LANGUAGE_ITALIAN
+    return "it";
+#else
+    return "en";
+#endif
+}

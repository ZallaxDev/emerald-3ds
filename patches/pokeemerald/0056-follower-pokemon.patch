+#include "text.h"
+#include "constants/battle.h"
+#include "constants/characters.h"
+#include "constants/event_object_movement.h"
+#include "constants/event_objects.h"
+#include "constants/flags.h"
+#include "constants/items.h"
+#include "constants/layouts.h"
+#include "constants/map_groups.h"
+#include "constants/map_types.h"
+#include "constants/pokemon.h"
+#include "constants/region_map_sections.h"
+#include "constants/songs.h"
+#include "constants/sound.h"
+#include "constants/species.h"
+#include "constants/vars.h"
+#include "constants/weather.h"
+
+/*
+ * The follower: the party's first Pokemon, unless it is an egg or has
+ * fainted, walks onto each tile the player leaves, at the player's pace. It
+ * stands on the player's own tile, unseen, when it has just come out (a warp,
+ * the field after a menu or a battle) and while it cannot follow: surfing,
+ * diving, on a bike, indoors for a Pokemon HGSS keeps in its ball there (the
+ * too-tall flag), or while the player is hidden. Talking to it turns it to the
+ * player with its cry and a hop.
+ *
+ * Its sprite is one followers/mon/KEY.bin of the data pack (FMN1: width,
+ * height, 8 frames, flags, the normal and the shiny palette, then the frames
+ * as 4bpp tiles, up, up, down, down, left, left, right, right), on an ext
+ * palette of its own tag (include/palette.h). Without the file, no follower.
+ */
+
+#define FMN_HEADER   8
+#define FMN_PALETTES (2 * 16 * 2)
+#define FMN_FRAMES   8
+#define FMN_FLAG_TOO_TALL 1
+#define FMN_FLAG_HOVER    4
+
+#define FOLLOWER_PAL_TAG 0x7F00
+#define OBJ_EVENT_PAL_TAG_NONE 0x11FF   /* as event_object_movement.c: no reflection palette of its own */
+#define FOLLOWER_QUEUE   4        /* player steps it may lag behind before it jumps to them */
+
+enum { SPEED_SLOW, SPEED_NORMAL, SPEED_FAST, SPEED_FASTER };
+
+struct FollowerStep
+{
+    s16 x, y;
+    u8 speed;
+};
+
+static struct
+{
+    u8 *file;                     /* the FMN1 file, the frames point into it */
+    u8 *previous;                 /* the one before: its last frame copy may still be queued */
+    char key[8];
+    u16 species;
+    u8 flags;
+    bool8 shiny;
+    u8 objectEventId;
+    bool8 hidden;
+    s16 lastX, lastY;             /* where the player stood */
+    u8 queued;
+    struct FollowerStep queue[FOLLOWER_QUEUE];
+    u8 checkTimer;
+    bool8 talking;                /* a talk script moves it */
+    u8 bob;
+    char missing[8];              /* a sprite already reported missing */
+    u8 waitLog;
+    bool8 inBall;                 /* unseen on the player's tile until it comes out */
+    u8 popTimer;                  /* coming out of its ball: unseen until the ball opens */
+    bool8 door;                   /* walking in through a door behind the player */
+    u8 doorTimer;
+    u8 swapTimer;                 /* going into its ball where it stands, for another lead */
+} sFollower = {.objectEventId = OBJECT_EVENTS_COUNT};
+
+static struct ObjectEventGraphicsInfo sGraphicsInfo;
+static struct SpriteFrameImage sFrames[FMN_FRAMES];
+
+const struct SubspriteTable *ObjectEventSubspriteTables(u32 dimension); // event_object_movement.c
+extern const struct OamData gObjectEventBaseOam_64x64;
+static void FollowerStepped(void);
+
+/* HGSS's frames: two a direction, both drawn while it walks; standing, it
+ * holds the first, still (no step in place). Laid out as sAnimTable_Standard,
+ * so the engine's anim numbers pick them. */
+#define FRAME_UP    0
+#define FRAME_DOWN  2
+#define FRAME_LEFT  4
+#define FRAME_RIGHT 6
+
+#define FOLLOWER_ANIM(name, frame, duration)       \
+static const union AnimCmd name[] =                \
+{                                                  \
+    ANIMCMD_FRAME((frame), (duration)),            \
+    ANIMCMD_FRAME((frame) + 1, (duration)),        \
+    ANIMCMD_FRAME((frame), (duration)),            \
+    ANIMCMD_FRAME((frame) + 1, (duration)),        \
+    ANIMCMD_JUMP(0),                               \
+}
+
+#define FOLLOWER_STAND(name, frame)                \
+static const union AnimCmd name[] =                \
+{                                                  \
+    ANIMCMD_FRAME((frame), 16),                    \
+    ANIMCMD_END,                                   \
+}
+
+FOLLOWER_STAND(sAnim_FaceSouth, FRAME_DOWN);
+FOLLOWER_STAND(sAnim_FaceNorth, FRAME_UP);
+FOLLOWER_STAND(sAnim_FaceWest, FRAME_LEFT);
+FOLLOWER_STAND(sAnim_FaceEast, FRAME_RIGHT);
+FOLLOWER_ANIM(sAnim_GoSouth, FRAME_DOWN, 8);
+FOLLOWER_ANIM(sAnim_GoNorth, FRAME_UP, 8);
+FOLLOWER_ANIM(sAnim_GoWest, FRAME_LEFT, 8);
+FOLLOWER_ANIM(sAnim_GoEast, FRAME_RIGHT, 8);
+FOLLOWER_ANIM(sAnim_GoFastSouth, FRAME_DOWN, 4);
+FOLLOWER_ANIM(sAnim_GoFastNorth, FRAME_UP, 4);
+FOLLOWER_ANIM(sAnim_GoFastWest, FRAME_LEFT, 4);
+FOLLOWER_ANIM(sAnim_GoFastEast, FRAME_RIGHT, 4);
+FOLLOWER_ANIM(sAnim_GoFasterSouth, FRAME_DOWN, 2);
+FOLLOWER_ANIM(sAnim_GoFasterNorth, FRAME_UP, 2);
+FOLLOWER_ANIM(sAnim_GoFasterWest, FRAME_LEFT, 2);
+FOLLOWER_ANIM(sAnim_GoFasterEast, FRAME_RIGHT, 2);
+FOLLOWER_ANIM(sAnim_GoFastestSouth, FRAME_DOWN, 1);
+FOLLOWER_ANIM(sAnim_GoFastestNorth, FRAME_UP, 1);
+FOLLOWER_ANIM(sAnim_GoFastestWest, FRAME_LEFT, 1);
+FOLLOWER_ANIM(sAnim_GoFastestEast, FRAME_RIGHT, 1);
+
+static const union AnimCmd *const sAnimTable_Follower[] = {
+    [ANIM_STD_FACE_SOUTH] = sAnim_FaceSouth,
+    [ANIM_STD_FACE_NORTH] = sAnim_FaceNorth,
+    [ANIM_STD_FACE_WEST] = sAnim_FaceWest,
+    [ANIM_STD_FACE_EAST] = sAnim_FaceEast,
+    [ANIM_STD_GO_SOUTH] = sAnim_GoSouth,
+    [ANIM_STD_GO_NORTH] = sAnim_GoNorth,
+    [ANIM_STD_GO_WEST] = sAnim_GoWest,
+    [ANIM_STD_GO_EAST] = sAnim_GoEast,
+    [ANIM_STD_GO_FAST_SOUTH] = sAnim_GoFastSouth,
+    [ANIM_STD_GO_FAST_NORTH] = sAnim_GoFastNorth,
+    [ANIM_STD_GO_FAST_WEST] = sAnim_GoFastWest,
+    [ANIM_STD_GO_FAST_EAST] = sAnim_GoFastEast,
+    [ANIM_STD_GO_FASTER_SOUTH] = sAnim_GoFasterSouth,
+    [ANIM_STD_GO_FASTER_NORTH] = sAnim_GoFasterNorth,
+    [ANIM_STD_GO_FASTER_WEST] = sAnim_GoFasterWest,
+    [ANIM_STD_GO_FASTER_EAST] = sAnim_GoFasterEast,
+    [ANIM_STD_GO_FASTEST_SOUTH] = sAnim_GoFastestSouth,
+    [ANIM_STD_GO_FASTEST_NORTH] = sAnim_GoFastestNorth,
+    [ANIM_STD_GO_FASTEST_WEST] = sAnim_GoFastestWest,
+    [ANIM_STD_GO_FASTEST_EAST] = sAnim_GoFastestEast,
+};
+
+static bool8 Enabled(void)
+{
+    return CtrExtras_Get("follower") == 1;
+}
+
+bool8 FollowerMon_IsFollower(const struct ObjectEvent *objectEvent)
+{
+    return objectEvent->active && objectEvent->localId == LOCALID_FOLLOWER
+        && objectEvent->graphicsId == OBJ_EVENT_GFX_FOLLOWER;
+}
+
+static struct ObjectEvent *FindFollower(void)
+{
+    u32 i;
+
+    if (sFollower.objectEventId < OBJECT_EVENTS_COUNT
+     && FollowerMon_IsFollower(&gObjectEvents[sFollower.objectEventId]))
+        return &gObjectEvents[sFollower.objectEventId];
+    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+    {
+        if (FollowerMon_IsFollower(&gObjectEvents[i]))
+        {
+            sFollower.objectEventId = i;
+            return &gObjectEvents[i];
+        }
+    }
+    sFollower.objectEventId = OBJECT_EVENTS_COUNT;
+    return NULL;
+}
+
+/* A Pokemon's sprite: "025", "025_f" where HGSS draws the female apart, Unown
+ * by letter ("201", "201_01".."201_27"). Empty if it has none. */
+static void MonKey(char *key, u16 species, u32 personality)
+{
+    u16 national;
+
+    key[0] = '\0';
+    if (species == SPECIES_NONE || species >= NUM_SPECIES)
+        return;
+    national = SpeciesToNationalPokedexNum(species);
+    if (national == 0 || national > 999)
+        return;
+    if (species == SPECIES_UNOWN && GET_UNOWN_LETTER(personality) != 0)
+    {
+        snprintf(key, 8, "%03u_%02u", national, (unsigned)GET_UNOWN_LETTER(personality));
+        return;
+    }
+    snprintf(key, 8, "%03u", national);
+    if (GetGenderFromSpeciesAndPersonality(species, personality) == MON_FEMALE)
+    {
+        char path[40];
+
+        snprintf(path, sizeof(path), "followers/mon/%03u_f.bin", national);
+        if (CtrData_Exists(path))
+            snprintf(key, 8, "%03u_f", national);
+    }
+}
+
+/* A sprite file read ahead (3ds_data.h), for a frame that will want it soon:
+ * read in that frame it is one read of the SD card, 10-30 ms on an Old 3DS. */
+static void PrefetchKey(const char *key)
+{
+    char path[40];
+
+    if (key[0] == '␀')
+        return;
+    snprintf(path, sizeof(path), "followers/mon/%s.bin", key);
+    CtrData_Prefetch(path);
+}
+
+/* The lead's: empty if none may follow. */
+static void LeadKey(char *key, u16 *species, bool8 *shiny)
+{
+    struct Pokemon *mon = &gPlayerParty[0];
+
+    key[0] = '\0';
+    *species = GetMonData(mon, MON_DATA_SPECIES);
+    if (GetMonData(mon, MON_DATA_IS_EGG) || GetMonData(mon, MON_DATA_HP) == 0)
+        return;
+    *shiny = IsMonShiny(mon);
+    MonKey(key, *species, GetMonData(mon, MON_DATA_PERSONALITY));
+}
+
+/* An FMN1 file read and checked: its frame size, 0 if it is not one. */
+static u32 LoadFmn(const char *key, u8 **out)
+{
+    char path[40];
+    u32 size, frameBytes;
+    u8 *file;
+    u8 w, h;
+
+    *out = NULL;
+    snprintf(path, sizeof(path), "followers/mon/%s.bin", key);
+    file = CtrData_Load(path, &size);
+    if (file == NULL)
+        return 0;
+    w = file[4];
+    h = file[5];
+    frameBytes = (u32)w * h / 2;
+    if (size < FMN_HEADER + FMN_PALETTES || memcmp(file, "FMN1", 4) != 0 || file[6] != FMN_FRAMES
+     || !((w == 32 && h == 32) || (w == 64 && h == 64))
+     || size < FMN_HEADER + FMN_PALETTES + FMN_FRAMES * frameBytes)
+    {
+        free(file);
+        return 0;
+    }
+    *out = file;
+    return frameBytes;
+}
+
+static void FreeFile(void)
+{
+    free(sFollower.previous);
+    sFollower.previous = sFollower.file;
+    sFollower.file = NULL;
+    sFollower.key[0] = '\0';
+}
+
+/* Reads KEY.bin and builds the graphics info over it. */
+static bool8 LoadSprite(const char *key)
+{
+    u32 frameBytes, i;
+    u8 *file;
+    u8 w;
+
+    if (sFollower.file != NULL && strcmp(sFollower.key, key) == 0)
+        return TRUE;
+    FreeFile();
+    frameBytes = LoadFmn(key, &file);
+    if (frameBytes == 0)
+        return FALSE;
+    w = file[4];
+    sFollower.file = file;
+    sFollower.flags = file[7];
+    strcpy(sFollower.key, key);
+    for (i = 0; i < FMN_FRAMES; i++)
+    {
+        sFrames[i].data = file + FMN_HEADER + FMN_PALETTES + i * frameBytes;
+        sFrames[i].size = frameBytes;
+        sFrames[i].offset = 0;
+    }
+    sGraphicsInfo.tileTag = TAG_NONE;
+    sGraphicsInfo.paletteTag = FOLLOWER_PAL_TAG;
+    sGraphicsInfo.reflectionPaletteTag = OBJ_EVENT_PAL_TAG_NONE;
+    sGraphicsInfo.size = frameBytes;
+    sGraphicsInfo.width = w;
+    sGraphicsInfo.height = w;
+    sGraphicsInfo.paletteSlot = PALSLOT_NPC_1;   /* PLTT_EXT_MODEL: the weather's rule for ext palettes */
+    sGraphicsInfo.shadowSize = w == 64 ? SHADOW_SIZE_L : SHADOW_SIZE_M;
+    sGraphicsInfo.inanimate = FALSE;
+    sGraphicsInfo.disableReflectionPaletteLoad = TRUE;
+    sGraphicsInfo.tracks = TRACKS_FOOT;
+    sGraphicsInfo.oam = w == 64 ? &gObjectEventBaseOam_64x64 : &gObjectEventBaseOam_32x32;
+    sGraphicsInfo.subspriteTables = ObjectEventSubspriteTables(w);
+    sGraphicsInfo.anims = sAnimTable_Follower;
+    sGraphicsInfo.images = sFrames;
+    sGraphicsInfo.affineAnims = gDummySpriteAffineAnimTable;
+    return TRUE;
+}
+
+const struct ObjectEventGraphicsInfo *FollowerMon_GraphicsInfo(void)
+{
+    if (sFollower.file == NULL)
+        return GetObjectEventGraphicsInfo(OBJ_EVENT_GFX_NINJA_BOY);
+    return &sGraphicsInfo;
+}
+
+/* Each time the follower's sprite is made (event_object_movement.c): its ext
+ * palette, loaded again if the field freed it (a battle, a menu). */
+void FollowerMon_BindSprite(struct Sprite *sprite)
+{
+    u8 slot = IndexOfSpritePaletteExtTag(FOLLOWER_PAL_TAG);
+
+    if (sFollower.file == NULL)
+        return;
+    if (slot == 0xFF)
+    {
+        const u16 *colors = (const u16 *)(sFollower.file + FMN_HEADER) + (sFollower.shiny ? 16 : 0);
+
+        slot = LoadSpritePaletteExt(&(const struct SpritePalette){colors, FOLLOWER_PAL_TAG});
+        if (slot == 0xFF)
+            return;
+        // Coming back to the field (a menu, a battle) the weather is still in
+        // the fade-out that left it: its colours would stay black. There the
+        // field's own fade-in brings them in, as the NPCs' palettes.
+        if (gMain.callback2 == CB2_Overworld)
+            UpdateSpritePaletteExtWithWeather(slot);
+    }
+    SetSpriteExtPalette(sprite, slot);
+}
+
+static void RemoveFollower(void)
+{
+    struct ObjectEvent *follower = FindFollower();
+
+    if (follower != NULL)
+        RemoveObjectEventByLocalIdAndMap(LOCALID_FOLLOWER, follower->mapNum, follower->mapGroup);
+    sFollower.objectEventId = OBJECT_EVENTS_COUNT;
+    FreeSpritePaletteByTag(FOLLOWER_PAL_TAG);
+}
+
+/*
+ * The visible wild Pokemon (wild_encounter.c) on the same sprites: a plain
+ * map-anchored sprite a slot, its file and an ext palette of the slot's tag.
+ * A file let go is freed one creation later, as the follower's: a frame copy
+ * from it may still be queued for VBlank.
+ */
+#define WILD_SLOTS       6
+#define WILD_PAL_TAG     0x7F01   /* + slot */
+
+static struct
+{
+    u8 *file, *stale;
+    struct SpriteFrameImage frames[FMN_FRAMES];
+} sWild[WILD_SLOTS];
+
+/* Why one has no HGSS sprite (it takes its icon then), once per species and
+ * reason: port.log tells a console run's missing pictures from the rest. */
+static void WildFail(const char *why, u16 species)
+{
+    static const char *sLastWhy;
+    static u16 sLastSpecies;
+
+    if (why == sLastWhy && species == sLastSpecies)
+        return;
+    sLastWhy = why;
+    sLastSpecies = species;
+    CtrLog_Write(CTR_LOG_GAME, "visible wild: species %u without its HGSS sprite: %s", species, why);
+}
+
+u8 FollowerMon_WildSprite(u32 slot, u16 species, u32 personality, bool8 shiny)
+{
+    struct SpriteTemplate template = {0};
+    char key[8];
+    u32 frameBytes, i;
+    u8 *file, spriteId, pal;
+
+    if (slot >= WILD_SLOTS)
+        return MAX_SPRITES;
+    free(sWild[slot].stale);
+    sWild[slot].stale = NULL;
+    MonKey(key, species, personality);
+    if (key[0] == '\0')
+    {
+        WildFail("no key", species);
+        return MAX_SPRITES;
+    }
+    frameBytes = LoadFmn(key, &file);
+    if (frameBytes == 0)
+    {
+        WildFail("no file in the data pack (or unreadable)", species);
+        return MAX_SPRITES;
+    }
+    FreeSpritePaletteByTag(WILD_PAL_TAG + slot);    /* another one's colours, left by a reset field */
+    pal = LoadSpritePaletteExt(&(const struct SpritePalette){
+        (const u16 *)(file + FMN_HEADER) + (shiny ? 16 : 0), WILD_PAL_TAG + slot});
+    if (pal == 0xFF)
+    {
+        WildFail("no ext palette free", species);
+        free(file);
+        return MAX_SPRITES;
+    }
+    UpdateSpritePaletteExtWithWeather(pal);
+    for (i = 0; i < FMN_FRAMES; i++)
+    {
+        sWild[slot].frames[i].data = file + FMN_HEADER + FMN_PALETTES + i * frameBytes;
+        sWild[slot].frames[i].size = frameBytes;
+        sWild[slot].frames[i].offset = 0;
+    }
+    template.tileTag = TAG_NONE;
+    template.paletteTag = TAG_NONE;
+    template.oam = file[4] == 64 ? &gObjectEventBaseOam_64x64 : &gObjectEventBaseOam_32x32;
+    template.anims = sAnimTable_Follower;
+    template.images = sWild[slot].frames;
+    template.affineAnims = gDummySpriteAffineAnimTable;
+    template.callback = SpriteCallbackDummy;
+    spriteId = CreateSprite(&template, 0, 0, 0);
+    if (spriteId >= MAX_SPRITES)
+    {
+        WildFail("no sprite free", species);
+        FreeSpritePaletteByTag(WILD_PAL_TAG + slot);
+        free(file);
+        return MAX_SPRITES;
+    }
+    SetSpriteExtPalette(&gSprites[spriteId], pal);
+    StartSpriteAnim(&gSprites[spriteId], ANIM_STD_FACE_SOUTH);
+    sWild[slot].file = file;
+    return spriteId;
+}
+
+/* The files a species may be shown on (male or female, Unown A), read ahead
+ * for the visible wild ones of a map's tables. */
+void FollowerMon_WildPrefetch(u16 species)
+{
+    char key[8], other[8];
+
+    MonKey(key, species, 0);        /* female where it can be */
+    MonKey(other, species, 0xFC);   /* male where it can be; Unown A either way */
+    PrefetchKey(key);
+    if (strcmp(other, key) != 0)
+        PrefetchKey(other);
+}
+
+/* Which way it looks, walking or standing. */
+void FollowerMon_WildFace(struct Sprite *sprite, s8 dx, s8 dy, bool8 walking)
+{
+    u8 anim;
+
+    if (dy < 0)
+        anim = ANIM_STD_FACE_NORTH;
+    else if (dx < 0)
+        anim = ANIM_STD_FACE_WEST;
+    else if (dx > 0)
+        anim = ANIM_STD_FACE_EAST;
+    else
+        anim = ANIM_STD_FACE_SOUTH;
+    if (walking)
+        anim += ANIM_STD_GO_SOUTH - ANIM_STD_FACE_SOUTH;
+    if (sprite->animNum != anim)
+        StartSpriteAnim(sprite, anim);
+}
+
+/* Its sprite gone (or, if still there, destroyed now). */
+void FollowerMon_WildFree(u32 slot, struct Sprite *sprite)
+{
+    if (slot >= WILD_SLOTS)
+        return;
+    if (sprite != NULL)
+        DestroySprite(sprite);
+    FreeSpritePaletteByTag(WILD_PAL_TAG + slot);
+    free(sWild[slot].stale);
+    sWild[slot].stale = sWild[slot].file;
+    sWild[slot].file = NULL;
+}
+
+/*
+ * Its Poke Ball, a moment where it goes in or comes out: Emerald's own ball
+ * picture (the battle's) on an ext palette, opening or closing on the tile.
+ */
+#define BALL_PAL_TAG 0x7F07
+#define BALL_FRAMES  24           /* going in: the ball closes and stays a moment */
+#define POP_FRAMES   10           /* coming out: the follower shows, the ball goes, once it is open */
+
+static const struct OamData sBallOam =
+{
+    .shape = SPRITE_SHAPE(16x16),
+    .size = SPRITE_SIZE(16x16),
+    .priority = 2,
+};
+
+/* The sheet's two pictures: closed (tile 0) and open (4); its third is the
+ * empty one the battle shows once the Pokemon is out. */
+static const union AnimCmd sBallOpen[] =
+{
+    ANIMCMD_FRAME(0, 5),
+    ANIMCMD_FRAME(4, 8),
+    ANIMCMD_END,
+};
+
+static const union AnimCmd sBallClose[] =
+{
+    ANIMCMD_FRAME(4, 6),
+    ANIMCMD_FRAME(0, 18),
+    ANIMCMD_END,
+};
+
+static const union AnimCmd *const sBallAnims[] = {sBallOpen, sBallClose};
+
+static u8 sBall = MAX_SPRITES;
+
+/* On its tile (map coordinates in data 1 and 2), placed each frame as the
+ * field's effects are: the camera moves the screen under it. */
+static void PlaceBall(struct Sprite *sprite)
+{
+    s16 x, y;
+
+    SetSpritePosToMapCoords(sprite->data[1], sprite->data[2], &x, &y);
+    sprite->x = x + 8;
+    sprite->y = y + 8;
+}
+
+static void SpriteCB_FollowerBall(struct Sprite *sprite)
+{
+    PlaceBall(sprite);
+    if (++sprite->data[0] < sprite->data[3])
+        return;
+    DestroySprite(sprite);
+    FreeSpriteTilesByTag(gBallSpriteSheets[BALL_POKE].tag);
+    FreeSpritePaletteByTag(BALL_PAL_TAG);
+    sBall = MAX_SPRITES;
+}
+
+static void ShowBall(struct ObjectEvent *follower, bool8 opening)
+{
+    struct SpriteTemplate template = {0};
+    const struct CompressedSpritePalette *palette = &gBallSpritePalettes[BALL_POKE];
+    u16 colors[16];
+    u8 pal;
+
+    if (sBall < MAX_SPRITES && gSprites[sBall].inUse && gSprites[sBall].callback == SpriteCB_FollowerBall)
+        DestroySprite(&gSprites[sBall]);
+    sBall = MAX_SPRITES;
+    if (GetDecompressedDataSize(palette->data) > sizeof(colors))
+        return;
+    LZ77UnCompWram(palette->data, colors);
+    FreeSpritePaletteByTag(BALL_PAL_TAG);
+    pal = LoadSpritePaletteExt(&(const struct SpritePalette){colors, BALL_PAL_TAG});
+    if (pal == 0xFF)
+        return;
+    UpdateSpritePaletteExtWithWeather(pal);
+    if (GetSpriteTileStartByTag(gBallSpriteSheets[BALL_POKE].tag) == 0xFFFF)
+        LoadCompressedSpriteSheetUsingHeap(&gBallSpriteSheets[BALL_POKE]);
+    template.tileTag = gBallSpriteSheets[BALL_POKE].tag;
+    template.paletteTag = TAG_NONE;
+    template.oam = &sBallOam;
+    template.anims = sBallAnims;
+    template.images = NULL;
+    template.affineAnims = gDummySpriteAffineAnimTable;
+    template.callback = SpriteCB_FollowerBall;
+    /* On its tile, in front of all for its moment: the objects' depth is
+     * worked out again each frame, and right behind the player its tile is
+     * under the player's head. */
+    {
+        struct Sprite *player = &gSprites[gObjectEvents[gPlayerAvatar.objectEventId].spriteId];
+
+        sBall = CreateSprite(&template, 0, 0, 1);
+        if (sBall >= MAX_SPRITES)
+        {
+            FreeSpritePaletteByTag(BALL_PAL_TAG);
+            return;
+        }
+        gSprites[sBall].oam.priority = player->oam.priority;
+    }
+    gSprites[sBall].coordOffsetEnabled = TRUE;
+    gSprites[sBall].data[1] = follower->currentCoords.x;
+    gSprites[sBall].data[2] = follower->currentCoords.y;
+    gSprites[sBall].data[3] = opening ? POP_FRAMES + 2 : BALL_FRAMES;
+    PlaceBall(&gSprites[sBall]);
+    SetSpriteExtPalette(&gSprites[sBall], pal);
+    StartSpriteAnim(&gSprites[sBall], opening ? 0 : 1);
+    PlaySE(opening ? SE_BALL_OPEN : SE_BALL);
+}
+
+static struct ObjectEvent *SpawnFollower(struct ObjectEvent *player)
+{
+    u8 id;
+    struct ObjectEvent *follower;
+
+    /* Every room taken by people further up the view: one of them makes way. */
+    FreeObjectEventSlotNearPlayer();
+    id = SpawnSpecialObjectEventParameterized(OBJ_EVENT_GFX_FOLLOWER, MOVEMENT_TYPE_NONE, LOCALID_FOLLOWER,
+                                              player->currentCoords.x, player->currentCoords.y,
+                                              player->currentElevation);
+    if (id >= OBJECT_EVENTS_COUNT)
+        return NULL;
+    follower = &gObjectEvents[id];
+    sFollower.objectEventId = id;
+    follower->invisible = TRUE;
+    follower->facingDirection = follower->movementDirection = player->facingDirection;
+    sFollower.lastX = player->currentCoords.x;
+    sFollower.lastY = player->currentCoords.y;
+    sFollower.queued = 0;
+    sFollower.inBall = TRUE;
+    sFollower.popTimer = 0;
+    sFollower.door = FALSE;
+    return follower;
+}
+
+static bool8 PalettesSettled(void)
+{
+    return !gPaletteFade.active
+        && (gWeatherPtr->palProcessingState == WEATHER_PAL_STATE_IDLE
+         || gWeatherPtr->palProcessingState == WEATHER_PAL_STATE_CHANGING_WEATHER);
+}
+
+bool8 FollowerMon_PalettesSettled(void)
+{
+    return PalettesSettled();
+}
+
+/* Where it cannot follow: it waits on the player's tile, unseen. */
+static bool8 MustHide(struct ObjectEvent *player)
+{
+    if (TestPlayerAvatarFlags(PLAYER_AVATAR_FLAG_SURFING | PLAYER_AVATAR_FLAG_UNDERWATER
+                            | PLAYER_AVATAR_FLAG_MACH_BIKE | PLAYER_AVATAR_FLAG_ACRO_BIKE))
+        return TRUE;
+    /* Through a door the player goes first, unseen; it follows (FollowerMon_DoorBegin). */
+    if ((player->invisible && !sFollower.door) || gMapHeader.mapType == MAP_TYPE_UNDERWATER)
+        return TRUE;
+    if ((sFollower.flags & FMN_FLAG_TOO_TALL) && IsMapTypeIndoors(gMapHeader.mapType))
+        return TRUE;
+    return FALSE;
+}
+
+/* The pace of the player's step, read from its movement action. */
+static u8 PlayerSpeed(struct ObjectEvent *player)
+{
+    u8 action = player->movementActionId;
+    u8 dir = player->movementDirection;
+
+    if (action == GetWalkSlowMovementAction(dir))
+        return SPEED_SLOW;
+    if (action == GetWalkFastMovementAction(dir) || action == GetPlayerRunMovementAction(dir)
+     || action == GetRideWaterCurrentMovementAction(dir))
+        return SPEED_FAST;
+    if (action == GetWalkFasterMovementAction(dir))
+        return SPEED_FASTER;
+    return SPEED_NORMAL;
+}
+
+static u8 WalkAction(u8 speed, u8 dir)
+{
+    switch (speed)
+    {
+    case SPEED_SLOW:
+        return GetWalkSlowMovementAction(dir);
+    case SPEED_FAST:
+        return GetWalkFastMovementAction(dir);
+    case SPEED_FASTER:
+        return GetWalkFasterMovementAction(dir);
+    default:
+        return GetWalkNormalMovementAction(dir);
+    }
+}
+
+static void Teleport(struct ObjectEvent *follower, s16 x, s16 y)
+{
+    MoveObjectEventToMapCoords(follower, x, y);
+    sFollower.queued = 0;
+}
+
+static void Enqueue(struct ObjectEvent *follower, s16 x, s16 y, u8 speed)
+{
+    if (sFollower.queued == FOLLOWER_QUEUE)
+    {
+        /* Too far behind (frozen by a script, a long scene): straight to it. */
+        Teleport(follower, x, y);
+        return;
+    }
+    sFollower.queue[sFollower.queued].x = x;
+    sFollower.queue[sFollower.queued].y = y;
+    sFollower.queue[sFollower.queued].speed = speed;
+    sFollower.queued++;
+}
+
+/* Starts the next queued step if the last one is over. */
+static void Advance(struct ObjectEvent *follower)
+{
+    struct FollowerStep step;
+    s16 dx, dy;
+    u8 dir;
+
+    if (follower->heldMovementActive && !ObjectEventClearHeldMovementIfFinished(follower))
+        return;
+    if (sFollower.queued == 0)
+        return;
+    step = sFollower.queue[0];
+    memmove(&sFollower.queue[0], &sFollower.queue[1], --sFollower.queued * sizeof(step));
+    dx = step.x - follower->currentCoords.x;
+    dy = step.y - follower->currentCoords.y;
+    if (dx == 0 && dy == 0)
+        return;
+    if (dx > 0)
+        dir = DIR_EAST;
+    else if (dx < 0)
+        dir = DIR_WEST;
+    else if (dy > 0)
+        dir = DIR_SOUTH;
+    else
+        dir = DIR_NORTH;
+    if (abs(dx) + abs(dy) == 1)
+    {
+        /* Behind by more than this step: a little faster, to catch up. */
+        u8 speed = step.speed;
+
+        if (sFollower.queued > 0 && speed < SPEED_FASTER)
+            speed++;
+        ObjectEventSetHeldMovement(follower, WalkAction(speed, dir));
+        gSprites[follower->spriteId].y2 = 0;   /* off the hover bob */
+    }
+    else if ((dx == 0 || dy == 0) && abs(dx) + abs(dy) == 2)
+    {
+        /* Where the player jumped a ledge. */
+        ObjectEventSetHeldMovement(follower, GetJump2MovementAction(dir));
+    }
+    else
+    {
+        Teleport(follower, step.x, step.y);
+    }
+}
+
+/*
+ * A door warp (field_screen_effect.c, Task_DoDoorWarp) freezes every object
+ * but the player: the follower is let go, walks onto the door behind the
+ * player and is gone in it before the door closes.
+ */
+void FollowerMon_DoorBegin(void)
+{
+    struct ObjectEvent *follower = FindFollower();
+
+    if (follower == NULL || sFollower.hidden || sFollower.inBall)
+        return;
+    UnfreezeObjectEvent(follower);
+    sFollower.door = TRUE;
+    sFollower.doorTimer = 0;
+}
+
+bool8 FollowerMon_DoorDone(void)
+{
+    struct ObjectEvent *follower = FindFollower();
+    struct ObjectEvent *player = &gObjectEvents[gPlayerAvatar.objectEventId];
+
+    if (!sFollower.door)
+        return TRUE;
+    if (follower == NULL || ++sFollower.doorTimer > 90
+     || (follower->currentCoords.x == player->currentCoords.x && follower->currentCoords.y == player->currentCoords.y
+      && !follower->heldMovementActive && sFollower.queued == 0))
+    {
+        sFollower.door = FALSE;
+        sFollower.inBall = TRUE;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+void FollowerMon_CameraShift(s16 dx, s16 dy)
+{
+    u32 i;
+
+    sFollower.lastX -= dx;
+    sFollower.lastY -= dy;
+    if (sBall < MAX_SPRITES && gSprites[sBall].inUse && gSprites[sBall].callback == SpriteCB_FollowerBall)
+    {
+        gSprites[sBall].data[1] -= dx;
+        gSprites[sBall].data[2] -= dy;
+    }
+    for (i = 0; i < sFollower.queued; i++)
+    {
+        sFollower.queue[i].x -= dx;
+        sFollower.queue[i].y -= dy;
+    }
+}
+
+void FollowerMon_Update(void)
+{
+    struct ObjectEvent *player, *follower;
+    struct Sprite *sprite;
+    bool8 hide, playerMoved;
+
+    if (gMain.callback2 != CB2_Overworld)
+        return;
+    if (!Enabled())
+    {
+        if (FindFollower() != NULL)
+            RemoveFollower();
+        return;
+    }
+    player = &gObjectEvents[gPlayerAvatar.objectEventId];
+    follower = FindFollower();
+
+    /* Its ball closed on it: the new lead comes out where it stood. */
+    if (sFollower.swapTimer > 0 && (follower == NULL || --sFollower.swapTimer == 0))
+    {
+        sFollower.swapTimer = 0;
+        if (follower != NULL)
+        {
+            s16 x = follower->currentCoords.x, y = follower->currentCoords.y;
+            u8 facing = follower->facingDirection;
+            char key[8];
+            u16 species = SPECIES_NONE;
+            bool8 shiny = FALSE;
+
+            RemoveFollower();
+            follower = NULL;
+            LeadKey(key, &species, &shiny);
+            if (key[0] != '\0' && LoadSprite(key))
+            {
+                sFollower.species = species;
+                sFollower.shiny = shiny;
+                follower = SpawnFollower(player);
+            }
+            if (follower != NULL)
+            {
+                /* off the player's tile, still in its ball: it pops out below */
+                Teleport(follower, x, y);
+                follower->facingDirection = follower->movementDirection = facing;
+                CtrLog_Write(CTR_LOG_GAME, "follower: %s%s out in its place", key, shiny ? " (shiny)" : "");
+            }
+        }
+    }
+
+    /* Held back by a fade (a save loaded): a new lead's file read meanwhile. */
+    if (follower == NULL && !PalettesSettled())
+    {
+        char key[8];
+        u16 species = SPECIES_NONE;
+        bool8 shiny = FALSE;
+
+        LeadKey(key, &species, &shiny);
+        if (sFollower.file == NULL || strcmp(key, sFollower.key) != 0)
+            PrefetchKey(key);
+    }
+    /* The lead changed (a swap, an evolution, it fainted): another sprite. */
+    if (follower == NULL && !PalettesSettled() && ++sFollower.waitLog == 240)
+        CtrLog_Write(CTR_LOG_GAME, "follower: waiting on the palettes (fade %d, weather state %d)",
+                     gPaletteFade.active, gWeatherPtr->palProcessingState);
+    /* Never mid-fade: a palette loaded then is left to a fade that is over. */
+    if ((follower == NULL || ++sFollower.checkTimer >= 16) && PalettesSettled() && sFollower.swapTimer == 0)
+    {
+        char key[8];
+        u16 species = SPECIES_NONE;
+        bool8 shiny = FALSE;
+
+        sFollower.checkTimer = 0;
+        LeadKey(key, &species, &shiny);
+        if (follower != NULL && (strcmp(key, sFollower.key) != 0 || shiny != sFollower.shiny))
+        {
+            /* In sight (back from the party menu, an evolution): it goes into
+             * its ball where it stands and the new lead comes out there. */
+            if (!sFollower.hidden && !sFollower.inBall && sFollower.popTimer == 0 && !sFollower.door
+             && !sFollower.talking && !follower->invisible)
+            {
+                ShowBall(follower, FALSE);
+                sFollower.swapTimer = BALL_FRAMES;
+                PrefetchKey(key);   /* read while the ball closes */
+            }
+            else
+            {
+                RemoveFollower();
+                follower = NULL;
+            }
+        }
+        if (follower == NULL)
+        {
+            if (key[0] == '\0')
+                return;
+            if (!LoadSprite(key))
+            {
+                if (strcmp(sFollower.missing, key) != 0)
+                    CtrLog_Write(CTR_LOG_GAME, "follower: no sprite %s in the data", key);
+                strcpy(sFollower.missing, key);
+                return;
+            }
+            sFollower.species = species;
+            sFollower.shiny = shiny;
+            follower = SpawnFollower(player);
+            if (follower == NULL)
+                return;
+            CtrLog_Write(CTR_LOG_GAME, "follower: %s%s out", key, shiny ? " (shiny)" : "");
+        }
+    }
+    /* None out yet: a fade still running (a save being loaded) holds it back. */
+    if (follower == NULL)
+        return;
+
+    playerMoved = player->currentCoords.x != sFollower.lastX || player->currentCoords.y != sFollower.lastY;
+    hide = MustHide(player);
+    if (hide != sFollower.hidden)
+    {
+        sFollower.hidden = hide;
+        if (hide)
+        {
+            /* Into its ball (surf, a bike, a building too small): not where
+             * the player itself vanished. */
+            if (!sFollower.inBall && !player->invisible && sFollower.swapTimer == 0)
+                ShowBall(follower, FALSE);
+            sFollower.inBall = TRUE;
+            Teleport(follower, player->currentCoords.x, player->currentCoords.y);
+        }
+    }
+    /* Its map is the player's: scripts find it by local id on that map. */
+    follower->mapNum = gSaveBlock1Ptr->location.mapNum;
+    follower->mapGroup = gSaveBlock1Ptr->location.mapGroup;
+    if (sFollower.talking && !ScriptContext_IsEnabled() && !ArePlayerFieldControlsLocked())
+        sFollower.talking = FALSE;
+
+    if (playerMoved)
+    {
+        if (hide)
+        {
+            Teleport(follower, player->currentCoords.x, player->currentCoords.y);
+        }
+        else
+        {
+            Enqueue(follower, sFollower.lastX, sFollower.lastY, PlayerSpeed(player));
+            FollowerStepped();
+        }
+        sFollower.lastX = player->currentCoords.x;
+        sFollower.lastY = player->currentCoords.y;
+    }
+    /* At a door: the last step, onto the door the player went through. */
+    if (sFollower.door && player->invisible && sFollower.queued == 0 && !follower->heldMovementActive
+     && abs(follower->currentCoords.x - player->currentCoords.x)
+      + abs(follower->currentCoords.y - player->currentCoords.y) == 1)
+        Enqueue(follower, player->currentCoords.x, player->currentCoords.y, SPEED_NORMAL);
+    if (!sFollower.talking)
+        Advance(follower);
+
+    /* In its ball on the player's tile (after a warp, a surf, a ride) until
+     * the player steps off, then out of it; gone in a door at its last step's
+     * end. Standing, it stands still. */
+    {
+        bool8 onPlayer = follower->currentCoords.x == player->currentCoords.x
+                      && follower->currentCoords.y == player->currentCoords.y;
+
+        if (!hide && sFollower.inBall && !onPlayer && !sFollower.door)
+        {
+            ShowBall(follower, TRUE);
+            sFollower.popTimer = POP_FRAMES;
+            sFollower.inBall = FALSE;
+        }
+        if (sFollower.popTimer > 0)
+            sFollower.popTimer--;
+        follower->invisible = hide || sFollower.inBall || sFollower.popTimer > 0 || sFollower.swapTimer > 0
+                           || (sFollower.door && onPlayer && !follower->heldMovementActive);
+    }
+    sprite = &gSprites[follower->spriteId];
+    if (!follower->heldMovementActive && sFollower.queued == 0 && !sFollower.talking)
+    {
+        StartSpriteAnimIfDifferent(sprite, GetFaceDirectionAnimNum(follower->facingDirection));
+        sprite->animPaused = FALSE;
+    }
+    /* A Pokemon that floats bobs, a pixel up and down. */
+    if ((sFollower.flags & FMN_FLAG_HOVER) && !follower->heldMovementActive)
+    {
+        sFollower.bob++;
+        sprite->y2 = (sFollower.bob & 0x20) ? -2 : ((sFollower.bob & 0x10) ? -1 : 0);
+    }
+}

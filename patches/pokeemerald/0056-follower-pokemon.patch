+#include "3ds_log.h"
+#include "event_data.h"
+#include "event_object_lock.h"
+#include "event_object_movement.h"
+#include "field_player_avatar.h"
+#include "field_weather.h"
+#include "fieldmap.h"
+#include "item.h"
+#include "decompress.h"
+#include "pokeball.h"
+#include "follower_mon.h"
+#include "malloc.h"
+#include "metatile_behavior.h"
+#include "overworld.h"

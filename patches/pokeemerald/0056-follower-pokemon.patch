+static bool8 LoadTexts(void)
+{
+    char path[40];
+    u32 size;
+
+    if (sTexts != NULL || sTextsTried)
+        return sTexts != NULL;
+    sTextsTried = TRUE;
+    snprintf(path, sizeof(path), "followers/text/%s.bin", LanguageCode());
+    sTexts = CtrData_Load(path, &size);
+    /* the last string ends the file: any offset inside it reads to an EOS */
+    if (sTexts != NULL && (size < 8 + 4 * TEXT_COUNT || memcmp(sTexts, "FMT1", 4) != 0
+                           || (sTexts[4] | (sTexts[5] << 8)) != TEXT_COUNT || sTexts[size - 1] != EOS))
+    {
+        free(sTexts);
+        sTexts = NULL;
+    }
+    sTextsSize = sTexts != NULL ? size : 0;
+    return sTexts != NULL;
+}
+
+static const u8 *RawMessage(u16 id)
+{
+    u32 offset;
+
+    if (sTexts == NULL || id >= TEXT_COUNT)
+        return NULL;
+    offset = sTexts[8 + 4 * id] | (sTexts[9 + 4 * id] << 8) | (sTexts[10 + 4 * id] << 16) | (sTexts[11 + 4 * id] << 24);
+    if (offset < 8 + 4 * TEXT_COUNT || offset >= sTextsSize)
+        return NULL;    /* a damaged file: no message rather than a read past it */
+    return sTexts + offset;
+}
+
+/* A soft reset puts this file's variables back as they were at boot, these
+ * pointers with them: what they hold is freed first, or each reset leaks the
+ * follower's and the wild sprites' files and the texts. No sprite may still
+ * use the frames (none does then: the game's sprites go back with the rest). */
+void FollowerMon_ReleaseAll(void)
+{
+    u32 i;
+
+    free(sFollower.file);
+    free(sFollower.previous);
+    sFollower.file = sFollower.previous = NULL;
+    sFollower.key[0] = '\0';
+    for (i = 0; i < WILD_SLOTS; i++)
+    {
+        free(sWild[i].file);
+        free(sWild[i].stale);
+        sWild[i].file = sWild[i].stale = NULL;
+    }
+    free(sTexts);
+    sTexts = NULL;
+    sTextsSize = 0;
+    sTextsTried = FALSE;
+}
+
+/*
+ * The message with its names put in, wrapped to the box: HGSS's lines are as
+ * wide as its own box and its names as long as they come, so the breaks are
+ * made here. Two lines a box, then the text scrolls; a page break of HGSS's
+ * starts a new box.
+ */
+static void BuildMessage(u8 *dest, u16 id)
+{
+    static u8 expanded[TEXT_MAX];
+    u8 word[TEXT_MAX];
+    const u8 *raw = RawMessage(id);
+    const u8 *src;
+    u8 *out = dest;
+    s32 lineWidth = 0, spaceWidth;
+    u32 lines = 0;
+
+    if (raw == NULL)
+    {
+        *dest = EOS;
+        return;
+    }
+    StringExpandPlaceholders(expanded, raw);
+    word[0] = CHAR_SPACE;
+    word[1] = EOS;
+    spaceWidth = GetStringWidth(FONT_NORMAL, word, 0);
+    for (src = expanded; *src != EOS;)
+    {
+        u32 n = 0;
+        s32 width;
+
+        if (*src == CHAR_PROMPT_CLEAR)
+        {
+            if (out != dest)
+                *out++ = CHAR_PROMPT_CLEAR;
+            lineWidth = 0;
+            lines = 0;
+            src++;
+            continue;
+        }
+        if (*src == CHAR_SPACE)
+        {
+            src++;
+            continue;
+        }
+        while (src[n] != EOS && src[n] != CHAR_SPACE && src[n] != CHAR_PROMPT_CLEAR && n < sizeof(word) - 1)
+        {
+            word[n] = src[n];
+            n++;
+        }
+        word[n] = EOS;
+        width = GetStringWidth(FONT_NORMAL, word, 0);
+        if (out + n + 2 >= dest + TEXT_MAX)
+            break;
+        if (lineWidth > 0 && lineWidth + spaceWidth + width > TEXT_WIDTH)
+        {
+            *out++ = (lines % 2 == 0) ? CHAR_NEWLINE : CHAR_PROMPT_SCROLL;
+            lines++;
+            lineWidth = 0;
+        }
+        else if (lineWidth > 0)
+        {
+            *out++ = CHAR_SPACE;
+            lineWidth += spaceWidth;
+        }
+        memcpy(out, word, n);
+        out += n;
+        lineWidth += width;
+        src += n;
+    }
+    *out = EOS;
+}
+
+static bool8 HasType(u16 species, u8 type)
+{
+    return gSpeciesInfo[species].types[0] == type || gSpeciesInfo[species].types[1] == type;
+}
+
+static bool8 OnMap(u16 map)
+{
+    return gSaveBlock1Ptr->location.mapGroup == (map >> 8) && gSaveBlock1Ptr->location.mapNum == (map & 0xFF);
+}
+
+/* Water a few tiles around: the sea, a lake. */
+static bool8 NearWater(s16 x, s16 y)
+{
+    s16 dx, dy;
+
+    for (dy = -3; dy <= 3; dy++)
+        for (dx = -4; dx <= 4; dx++)
+            if (MetatileBehavior_IsSurfableWaterOrUnderwater(MapGridGetMetatileBehaviorAt(x + dx, y + dy)))
+                return TRUE;
+    return FALSE;
+}
+
+static u32 Hour(void)
+{
+    unsigned seconds, rate;
+
+    if (CtrDayNight_Active() && CtrDayNight_Time(&seconds, &rate))
+        return (seconds / 3600) % 24;
+    RtcCalcLocalTime();
+    return gLocalTime.hours;
+}
+
+static u16 Pick(struct MsgPool pool)
+{
+    return pool.ids[Random() % pool.count];
+}
+
+static u16 ChooseOnce(struct ObjectEvent *follower)
+{
+    struct Pokemon *mon = &gPlayerParty[0];
+    struct MsgPool pools[16];
+    u32 count = 0, status = GetMonData(mon, MON_DATA_STATUS);
+    u16 species = sFollower.species, hp = GetMonData(mon, MON_DATA_HP), maxHp = GetMonData(mon, MON_DATA_MAX_HP);
+    u8 friendship = GetMonData(mon, MON_DATA_FRIENDSHIP), weather = GetCurrentWeather();
+    u8 mapType = gMapHeader.mapType, mapsec = gMapHeader.regionMapSectionId;
+    u32 behavior = MapGridGetMetatileBehaviorAt(follower->currentCoords.x, follower->currentCoords.y);
+    bool8 outdoors = IsMapTypeOutdoors(mapType);
+    u32 hour = Hour();
+
+    if (status & STATUS1_PSN_ANY)
+        return Pick(POOL(sMsgPoison));
+    if (status & STATUS1_BURN)
+        return Pick(POOL(sMsgBurn));
+    if (status & STATUS1_PARALYSIS)
+        return Pick(POOL(sMsgParalysis));
+    if (status & STATUS1_SLEEP)
+        return Pick(POOL(sMsgSleep));
+    if (status & STATUS1_FREEZE)
+        return Pick(POOL(sMsgFreeze));
+    if (hp * 4 < maxHp && Random() % 4 != 0)
+        return Pick(POOL(sMsgTired));
+    if (GetMonData(mon, MON_DATA_HELD_ITEM) != ITEM_NONE && Random() % 8 == 0)
+        return Pick(POOL(sMsgHeldItem));
+
+    /* Where it is. */
+    switch (weather)
+    {
+    case WEATHER_RAIN:
+    case WEATHER_RAIN_THUNDERSTORM:
+    case WEATHER_DOWNPOUR:
+        pools[count++] = HasType(species, TYPE_WATER) ? POOL(sMsgRainWater) : POOL(sMsgRain);
+        if (MetatileBehavior_IsTallGrass(behavior) || MetatileBehavior_IsLongGrass(behavior))
+            pools[count++] = POOL(sMsgRainGrass);
+        break;
+    case WEATHER_DROUGHT:
+        pools[count++] = HasType(species, TYPE_FIRE) ? POOL(sMsgHotFire) : POOL(sMsgHot);
+        break;
+    case WEATHER_SANDSTORM:
+        pools[count++] = HasType(species, TYPE_GROUND) ? POOL(sMsgSandstormGround) : POOL(sMsgSandstorm);
+        break;
+    case WEATHER_FOG_HORIZONTAL:
+    case WEATHER_FOG_DIAGONAL:
+        pools[count++] = POOL(sMsgFog);
+        break;
+    case WEATHER_VOLCANIC_ASH:
+        pools[count++] = POOL(sMsgAsh);
+        break;
+    case WEATHER_SUNNY:
+        if (outdoors && hour >= 9 && hour < 17)
+            pools[count++] = POOL(sMsgFineDay);
+        break;
+    }
+    if (mapsec == MAPSEC_FIERY_PATH || mapsec == MAPSEC_FIERY_PATH2 || mapsec == MAPSEC_MT_CHIMNEY
+     || mapsec == MAPSEC_LAVARIDGE_TOWN || mapsec == MAPSEC_MAGMA_HIDEOUT)
+        pools[count++] = HasType(species, TYPE_FIRE) ? POOL(sMsgHotFire) : POOL(sMsgHot);
+    if (mapsec == MAPSEC_SHOAL_CAVE)
+        pools[count++] = HasType(species, TYPE_ICE) ? POOL(sMsgColdIce) : POOL(sMsgCold);
+    if (MetatileBehavior_IsIce(behavior))
+        pools[count++] = POOL(sMsgIceFloor);
+    if (MetatileBehavior_IsTallGrass(behavior) || MetatileBehavior_IsLongGrass(behavior))
+        pools[count++] = POOL(sMsgGrass);
+    if (MetatileBehavior_IsSandOrDeepSand(behavior))
+        pools[count++] = POOL(sMsgSand);
+    if (MetatileBehavior_IsPuddle(behavior))
+        pools[count++] = POOL(sMsgPuddle);
+    if (outdoors && NearWater(follower->currentCoords.x, follower->currentCoords.y))
+        pools[count++] = POOL(sMsgSea);
+    if (mapsec == MAPSEC_PETALBURG_WOODS)
+        pools[count++] = POOL(sMsgForest);
+    if (mapsec == MAPSEC_METEOR_FALLS || mapsec == MAPSEC_METEOR_FALLS2)
+        pools[count++] = POOL(sMsgWaterfall);
+    if (mapsec == MAPSEC_MT_PYRE || mapsec == MAPSEC_ABANDONED_SHIP || mapsec == MAPSEC_SKY_PILLAR)
+        pools[count++] = POOL(sMsgEerie);
+    if (mapsec == MAPSEC_MT_CHIMNEY || mapsec == MAPSEC_JAGGED_PASS || mapsec == MAPSEC_JAGGED_PASS2
+     || mapsec == MAPSEC_ROUTE_112)
+        pools[count++] = POOL(sMsgMountain);
+    if (mapsec == MAPSEC_NEW_MAUVILLE || OnMap(MAP_MOSSDEEP_CITY_SPACE_CENTER_1F) || OnMap(MAP_MOSSDEEP_CITY_SPACE_CENTER_2F)
+     || OnMap(MAP_ROUTE119_WEATHER_INSTITUTE_1F) || OnMap(MAP_ROUTE119_WEATHER_INSTITUTE_2F)
+     || OnMap(MAP_RUSTBORO_CITY_DEVON_CORP_1F) || OnMap(MAP_RUSTBORO_CITY_DEVON_CORP_2F)
+     || OnMap(MAP_RUSTBORO_CITY_DEVON_CORP_3F))
+        pools[count++] = POOL(sMsgMachine);
+    if (OnMap(MAP_SS_TIDAL_CORRIDOR) || OnMap(MAP_SS_TIDAL_LOWER_DECK) || OnMap(MAP_SS_TIDAL_ROOMS))
+        pools[count++] = POOL(sMsgBoat);
+    if (mapType == MAP_TYPE_UNDERGROUND)
+        pools[count++] = POOL(sMsgCave);
+    if (gMapHeader.mapLayoutId == LAYOUT_MART)
+        pools[count++] = POOL(sMsgMart);
+    else if (gMapHeader.mapLayoutId == LAYOUT_POKEMON_CENTER_1F)
+        pools[count++] = POOL(sMsgPokemonCenter);
+    else if (mapType == MAP_TYPE_INDOOR)
+        pools[count++] = POOL(sMsgIndoors);
+    if (outdoors)
+    {
+        if (hour >= 5 && hour < 9)
+            pools[count++] = POOL(sMsgMorning);
+        else if (hour >= 17 && hour < 20)
+            pools[count++] = POOL(sMsgEvening);
+        else if (hour >= 20 || hour < 5)
+            pools[count++] = POOL(sMsgNight);
+    }
+    if (count > 0 && Random() % 5 < 2)
+        return Pick(pools[Random() % count]);
+
+    /* What it is. */
+    if (Random() % 4 == 0)
+    {
+        count = 0;
+        if (HasType(species, TYPE_FIRE))
+            pools[count++] = POOL(sMsgFire);
+        if (HasType(species, TYPE_ELECTRIC))
+            pools[count++] = POOL(sMsgElectric);
+        if (HasType(species, TYPE_GRASS))
+            pools[count++] = POOL(sMsgGrassType);
+        if (HasType(species, TYPE_WATER))
+            pools[count++] = POOL(sMsgWater);
+        if (HasType(species, TYPE_GROUND))
+            pools[count++] = POOL(sMsgGround);
+        if (HasType(species, TYPE_ROCK))
+            pools[count++] = POOL(sMsgRock);
+        if (HasType(species, TYPE_DRAGON))
+            pools[count++] = POOL(sMsgDragon);
+        if (HasType(species, TYPE_PSYCHIC))
+            pools[count++] = POOL(sMsgPsychic);
+        if (HasType(species, TYPE_FIGHTING))
+            pools[count++] = POOL(sMsgFighting);
+        if (HasType(species, TYPE_FLYING) && outdoors)
+            pools[count++] = POOL(sMsgFlying);
+        if (HasType(species, TYPE_GHOST))
+            pools[count++] = POOL(sMsgGhost);
+        if (count > 0)
+            return Pick(pools[Random() % count]);
+    }
+
+    /* How it feels about the player. */
+    if (friendship < 70)
+        return Pick(POOL(sMsgSad));
+    if (friendship >= 150 || Random() % 2 == 0)
+        return Pick(POOL(sMsgHappy));
+    return Pick(POOL(sMsgNeutral));
+}
+
+/* Never the same line twice in a row, when another one comes up. */
+static u16 ChooseMessage(struct ObjectEvent *follower)
+{
+    static u16 sLast = 0xFFFF;
+    u16 id = ChooseOnce(follower);
+    u32 tries;
+
+    for (tries = 0; id == sLast && tries < 4; tries++)
+        id = ChooseOnce(follower);
+    sLast = id;
+    return id;
+}
+
+/*
+ * Items it may find walking, by how far the player has come: one step in 64
+ * after a while without one.
+ */
+static const u16 sFoundEarly[] = {ITEM_POTION, ITEM_POKE_BALL, ITEM_ANTIDOTE, ITEM_PARALYZE_HEAL, ITEM_ORAN_BERRY,
+                                  ITEM_PECHA_BERRY, ITEM_CHERI_BERRY, ITEM_RAWST_BERRY, ITEM_ESCAPE_ROPE};
+static const u16 sFoundMiddle[] = {ITEM_SUPER_POTION, ITEM_GREAT_BALL, ITEM_REVIVE, ITEM_FULL_HEAL, ITEM_ETHER,
+                                   ITEM_SITRUS_BERRY, ITEM_LUM_BERRY, ITEM_REPEL, ITEM_SUPER_REPEL};
+static const u16 sFoundLate[] = {ITEM_HYPER_POTION, ITEM_ULTRA_BALL, ITEM_MAX_REPEL, ITEM_MAX_ETHER, ITEM_FULL_RESTORE,
+                                 ITEM_NUGGET, ITEM_PP_UP, ITEM_RARE_CANDY, ITEM_MAX_REVIVE};
+#define FOUND_STEPS_MIN 300
+
+static u16 sStepsSinceFind;
+static u16 sFoundItem;
+
+static u32 Badges(void)
+{
+    u32 i, n = 0;
+
+    for (i = FLAG_BADGE01_GET; i <= FLAG_BADGE08_GET; i++)
+        n += FlagGet(i) != 0;
+    return n;
+}
+
+static void FollowerStepped(void)
+{
+    if (sFoundItem != ITEM_NONE || ++sStepsSinceFind < FOUND_STEPS_MIN || Random() % 64 != 0)
+        return;
+    if (Badges() >= 6)
+        sFoundItem = sFoundLate[Random() % ARRAY_COUNT(sFoundLate)];
+    else if (Badges() >= 3)
+        sFoundItem = sFoundMiddle[Random() % ARRAY_COUNT(sFoundMiddle)];
+    else
+        sFoundItem = sFoundEarly[Random() % ARRAY_COUNT(sFoundEarly)];
+    sStepsSinceFind = 0;
+}
+
+/* The script, built for each talk: what it says is known only then. */
+#define SCR_END                  0x02
+#define SCR_GOTO                 0x05
+#define SCR_GOTO_IF              0x06
+#define SCR_CALLSTD              0x09
+#define SCR_SETORCOPYVAR         0x1a
+#define SCR_COMPARE_VAR_TO_VALUE 0x21
+#define SCR_APPLYMOVEMENT        0x4f
+#define SCR_WAITMOVEMENT         0x51
+#define SCR_FACEPLAYER           0x5a
+#define SCR_WAITMESSAGE          0x66
+#define SCR_MESSAGE              0x67
+#define SCR_LOCK                 0x6a
+#define SCR_RELEASE              0x6c
+#define SCR_WAITBUTTONPRESS      0x6d
+#define SCR_YESNOBOX             0x6e
+#define SCR_PLAYMONCRY           0xa1
+#define STD_OBTAIN_ITEM          0
+
+static u8 *Put8(u8 *p, u32 v)
+{
+    *p++ = v;
+    return p;
+}
+
+static u8 *Put16(u8 *p, u32 v)
+{
+    *p++ = v;
+    *p++ = v >> 8;
+    return p;
+}
+
+static u8 *Put32(u8 *p, const void *v)
+{
+    u32 a = (u32)v;
+
+    p = Put16(p, a);
+    return Put16(p, a >> 16);
+}
+
+static u8 *PutMessage(u8 *p, const u8 *text)
+{
+    p = Put8(p, SCR_MESSAGE);
+    p = Put32(p, text);
+    p = Put8(p, SCR_WAITMESSAGE);
+    return Put8(p, SCR_WAITBUTTONPRESS);
+}
+
+static u8 *PutEnd(u8 *p)
+{
+    p = Put8(p, SCR_RELEASE);
+    return Put8(p, SCR_END);
+}
+
+const u8 *FollowerMon_TalkScript(void)
+{
+    struct ObjectEvent *follower = FindFollower();
+    u16 item = GetMonData(&gPlayerParty[0], MON_DATA_HELD_ITEM);
+    u8 *p = sScript;
+
+    if (follower == NULL)
+        return NULL;
+    /* While it talks, the script moves it, not the following. */
+    sFollower.talking = TRUE;
+    GetMonData(&gPlayerParty[0], MON_DATA_NICKNAME, gStringVar1);
+    StringGet_Nickname(gStringVar1);
+    p = Put8(p, SCR_LOCK);
+    p = Put8(p, SCR_FACEPLAYER);
+    p = Put8(p, SCR_PLAYMONCRY);
+    p = Put16(p, sFollower.species);
+    p = Put16(p, CRY_MODE_NORMAL);
+    sHop[0] = GetJumpInPlaceMovementAction(GetOppositeDirection(GetPlayerFacingDirection()));
+    sHop[1] = MOVEMENT_ACTION_STEP_END;
+    p = Put8(p, SCR_APPLYMOVEMENT);
+    p = Put16(p, LOCALID_FOLLOWER);
+    p = Put32(p, sHop);
+    p = Put8(p, SCR_WAITMOVEMENT);
+    p = Put16(p, LOCALID_FOLLOWER);
+    if (!LoadTexts())
+    {
+        PutEnd(p);
+        return sScript;
+    }
+
+    if (sFoundItem != ITEM_NONE)
+    {
+        u8 *patch;
+
+        CopyItemName(sFoundItem, gStringVar2);
+        BuildMessage(sText, MSG_FOUND_ASK);
+        BuildMessage(sTextNo, MSG_FOUND_NO);
+        BuildMessage(sTextYes, MSG_FOUND_YES);
+        p = Put8(p, SCR_MESSAGE);
+        p = Put32(p, sText);
+        p = Put8(p, SCR_WAITMESSAGE);
+        p = Put8(p, SCR_YESNOBOX);
+        p = Put8(p, 20);
+        p = Put8(p, 8);
+        p = Put8(p, SCR_COMPARE_VAR_TO_VALUE);
+        p = Put16(p, VAR_RESULT);
+        p = Put16(p, 1);           /* YES */
+        p = Put8(p, SCR_GOTO_IF);
+        p = Put8(p, 1);            /* equal */
+        patch = p;
+        p += 4;
+        p = PutMessage(p, sTextNo);
+        p = PutEnd(p);
+        Put32(patch, p);
+        p = PutMessage(p, sTextYes);
+        p = Put8(p, SCR_SETORCOPYVAR);
+        p = Put16(p, VAR_0x8000);
+        p = Put16(p, sFoundItem);
+        p = Put8(p, SCR_SETORCOPYVAR);
+        p = Put16(p, VAR_0x8001);
+        p = Put16(p, 1);
+        p = Put8(p, SCR_CALLSTD);
+        p = Put8(p, STD_OBTAIN_ITEM);
+        PutEnd(p);
+        sFoundItem = ITEM_NONE;
+        return sScript;
+    }
+    if (item != ITEM_NONE)
+        CopyItemName(item, gStringVar2);
+    {
+        u16 id = ChooseMessage(follower);
+
+        CtrLog_Write(CTR_LOG_GAME, "follower: says %u", id);
+        BuildMessage(sText, id);
+    }
+    p = PutMessage(p, sText);
+    PutEnd(p);
+    return sScript;
+}
+#endif

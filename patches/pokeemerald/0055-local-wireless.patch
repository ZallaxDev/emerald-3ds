 #define DmaCopyLarge(dmaNum, src, dest, size, block, bit) \
 {                                                         \
     const void *_src = src;                               \
@@ -182,6 +193,7 @@ extern void DmaSet(int dmaNum, const void * src, void * dest, u32 control);
         }                                                 \

+#ifdef PLATFORM_3DS
+static void TryReceiveDirectBattleData(void)
+{
+    static u8 msg[0x400];
+    u16 len, dataSize;
+    s32 j;
+
+    while ((len = PlatformLinkBattleRecv(msg, sizeof(msg))) >= LINK_BUFF_DATA)
+    {

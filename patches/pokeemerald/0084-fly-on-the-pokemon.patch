+/*
+ * Fly on the Pokemon that flies (field_effect.c): its sprite of the same
+ * files in place of the bird, facing west as the bird flies, its wings (or
+ * legs) going; on an ext palette of its own tag. The file is kept for the
+ * landing after the warp (the same Pokemon) and let go with its sprite.
+ */
+#define FLY_PAL_TAG 0x7F08
+
+static struct
+{
+    u8 *file, *stale;
+    char key[8];
+    struct SpriteFrameImage frames[FMN_FRAMES];
+    struct SpriteTemplate template;
+} sFly;
+
+void FollowerMon_FlyPrefetch(u16 species, u32 personality)
+{
+    char key[8];
+
+    MonKey(key, species, personality);
+    if (key[0] != '\0' && strcmp(key, sFly.key) != 0)
+        PrefetchKey(key);
+}
+
+/* A frame's visible pixels' box, in pixels of the frame; x1 < 0 if blank. */
+static void FrameBox(const u8 *tiles, u32 w, int *x0, int *y0, int *x1, int *y1)
+{
+    u32 x, y;
+
+    *x0 = *y0 = w;
+    *x1 = *y1 = -1;
+    for (y = 0; y < w; y++)
+        for (x = 0; x < w; x++)
+        {
+            const u8 *tile = tiles + ((y / 8) * (w / 8) + x / 8) * 32;
+
+            if (((tile[(y & 7) * 4 + (x & 7) / 2] >> ((x & 1) * 4)) & 15) == 0)
+                continue;
+            if ((int)x < *x0) *x0 = x;
+            if ((int)x > *x1) *x1 = x;
+            if ((int)y < *y0) *y0 = y;
+            if ((int)y > *y1) *y1 = y;
+        }
+}
+
+u8 FollowerMon_FlySprite(u16 species, u32 personality, bool8 shiny, s16 x, s16 y, u8 subpriority,
+                         s8 *riderX, s8 *riderY)
+{
+    char key[8];
+    u32 frameBytes, i;
+    u8 *file, spriteId, pal, w;
+    int bx0, by0, bx1, by1;
+
+    MonKey(key, species, personality);
+    if (key[0] == '\0')
+        return MAX_SPRITES;
+    free(sFly.stale);
+    sFly.stale = NULL;
+    if (sFly.file != NULL && strcmp(sFly.key, key) == 0)
+    {
+        file = sFly.file;
+        frameBytes = (u32)file[4] * file[5] / 2;
+    }
+    else
+    {
+        frameBytes = LoadFmn(key, &file);
+        if (frameBytes == 0)
+        {
+            CtrLog_Write(CTR_LOG_GAME, "fly: no sprite %s in the data, the bird flies", key);
+            return MAX_SPRITES;
+        }
+        sFly.stale = sFly.file;
+        sFly.file = file;
+        strcpy(sFly.key, key);
+    }
+    w = file[4];
+    FreeSpritePaletteByTag(FLY_PAL_TAG);
+    pal = LoadSpritePaletteExt(&(const struct SpritePalette){
+        (const u16 *)(file + FMN_HEADER) + (shiny ? 16 : 0), FLY_PAL_TAG});
+    if (pal == 0xFF)
+        return MAX_SPRITES;
+    UpdateSpritePaletteExtWithWeather(pal);
+    for (i = 0; i < FMN_FRAMES; i++)
+    {
+        sFly.frames[i].data = file + FMN_HEADER + FMN_PALETTES + i * frameBytes;
+        sFly.frames[i].size = frameBytes;
+        sFly.frames[i].offset = 0;
+    }
+    sFly.template.tileTag = TAG_NONE;
+    sFly.template.paletteTag = TAG_NONE;
+    sFly.template.oam = w == 64 ? &gObjectEventBaseOam_64x64 : &gObjectEventBaseOam_32x32;
+    sFly.template.anims = sAnimTable_Follower;
+    sFly.template.images = sFly.frames;
+    sFly.template.affineAnims = gDummySpriteAffineAnimTable;
+    sFly.template.callback = SpriteCallbackDummy;
+    spriteId = CreateSprite(&sFly.template, x, y, subpriority);
+    if (spriteId >= MAX_SPRITES)
+    {
+        FreeSpritePaletteByTag(FLY_PAL_TAG);
+        return MAX_SPRITES;
+    }
+    SetSpriteExtPalette(&gSprites[spriteId], pal);
+    StartSpriteAnim(&gSprites[spriteId], ANIM_STD_GO_WEST);
+    /* The player sits 4 pixels under the top of the Pokemon seen from the
+     * side, over the middle of it: as on the bird (its top at row 4 of 32,
+     * the player 8 above its centre). */
+    FrameBox(sFly.frames[FRAME_LEFT].data, w, &bx0, &by0, &bx1, &by1);
+    if (bx1 >= 0)
+    {
+        *riderX = (bx0 + bx1 + 1) / 2 - w / 2;
+        *riderY = by0 + 4 - w / 2;
+    }
+    CtrLog_Write(CTR_LOG_GAME, "fly: on %s%s (%ux%u, rider at %d,%d)", key, shiny ? " (shiny)" : "", w, w,
+                 *riderX, *riderY);
+    return spriteId;
+}
+
+bool8 FollowerMon_IsFlySprite(const struct Sprite *sprite)
+{
+    return sprite->inUse && sprite->template == &sFly.template;
+}
+
+void FollowerMon_FlyFree(struct Sprite *sprite)
+{
+    if (sprite != NULL && FollowerMon_IsFlySprite(sprite))
+        DestroySprite(sprite);
+    FreeSpritePaletteByTag(FLY_PAL_TAG);
+    free(sFly.stale);
+    sFly.stale = sFly.file;
+    sFly.file = NULL;
+    sFly.key[0] = '\0';
 }
 

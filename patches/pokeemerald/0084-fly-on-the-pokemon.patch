+#ifdef PLATFORM_3DS
+// Port: Fly on the Pokemon that flies, on its overworld sprite of the
+// follower's files (follower_mon.c) in place of the bird; kept from the
+// flight out for the landing after the warp. SPECIES_NONE, or no sprite for
+// it: the bird. The player sits where its sprite says (sFlyRiderX/Y).
+static u16 sFlyMonSpecies;
+static u32 sFlyMonPersonality;
+static bool8 sFlyMonShiny;
+static s8 sFlyRiderX, sFlyRiderY = -8;
+
+static void FlyMon_Choose(u32 slot)
+{
+    struct Pokemon *mon;
+
+    sFlyMonSpecies = SPECIES_NONE;
+    if (slot >= PARTY_SIZE)
+        return;
+    mon = &gPlayerParty[slot];
+    if (GetMonData(mon, MON_DATA_IS_EGG))
+        return;
+    sFlyMonSpecies = GetMonData(mon, MON_DATA_SPECIES);
+    sFlyMonPersonality = GetMonData(mon, MON_DATA_PERSONALITY);
+    sFlyMonShiny = IsMonShiny(mon);
+    // Read while the field move's banner shows.
+    FollowerMon_FlyPrefetch(sFlyMonSpecies, sFlyMonPersonality);
+}
+#endif
 
 u8 FldEff_UseFly(void)
 {
     u8 taskId = CreateTask(Task_FlyOut, 254);
     gTasks[taskId].tMonId = gFieldEffectArguments[0];
+#ifdef PLATFORM_3DS
+    FlyMon_Choose(gFieldEffectArguments[0]);
+#endif
     return 0;
 }
 

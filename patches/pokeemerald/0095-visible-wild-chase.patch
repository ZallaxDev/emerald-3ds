+/*
+ * WILD CHASE: one that may (VisibleRollAggressive) notices the player within
+ * VW_NOTICE tiles, where it lives, with a hop and a cry of alarm, and runs at
+ * them; it gives up after VW_CHASE_FRAMES or beyond VW_CHASE_LOST tiles, and
+ * strolls on, never to notice them again.
+ */
+static void VisibleNotice(struct VisibleWild *v, s16 px, s16 py, bool8 inWater)
+{
+    s16 ddx = px - v->x, ddy = py - v->y;
+
+    if (v->hop)
+        v->hop--;
+    if (v->chasing)
+    {
+        if (++v->chase > VW_CHASE_FRAMES || VW_ABS(ddx) + VW_ABS(ddy) > VW_CHASE_LOST || v->water != inWater)
+        {
+            v->chasing = FALSE;
+            v->aggressive = FALSE;
+            if (!v->progress)
+                v->idle = 120;
+        }
+        return;
+    }
+    if (!v->aggressive || v->progress || v->water != inWater || VW_ABS(ddx) + VW_ABS(ddy) > VW_NOTICE)
+        return;
+    v->chasing = TRUE;
+    v->chase = 0;
+    v->hop = VW_HOP;
+    v->idle = VW_HOP + 8;        /* the hop, then it runs */
+    if (VW_ABS(ddx) >= VW_ABS(ddy))
+    {
+        v->faceX = ddx < 0 ? -1 : 1;
+        v->faceY = 0;
+    }
+    else
+    {
+        v->faceX = 0;
+        v->faceY = ddy < 0 ? -1 : 1;
+    }
+    PlaySE(SE_PIN);
+    CtrLog_Write(CTR_LOG_GAME, "visible wild: species %u runs at the player", v->species);
+}

+
+/*
+ * The Fly sky scene's sprites (3ds_port/src/3ds_fly_sky.c): the files of the
+ * Pokemon it shows, up to SKY_FILES of them, held until FollowerMon_SkyRelease.
+ */
+#define SKY_FILES 8
+
+static struct
+{
+    u8 *file;
+    char key[8];
+} sSky[SKY_FILES];
+
+u32 FollowerMon_SkyFile(u16 species, u32 personality, const u8 **file)
+{
+    char key[8];
+    u32 i, frameBytes;
+    u8 *data;
+
+    *file = NULL;
+    MonKey(key, species, personality);
+    if (key[0] == '\0')
+        return 0;
+    for (i = 0; i < SKY_FILES && sSky[i].file != NULL; i++)
+        if (strcmp(sSky[i].key, key) == 0)
+        {
+            *file = sSky[i].file;
+            return (u32)sSky[i].file[4] * sSky[i].file[5] / 2;
+        }
+    if (i == SKY_FILES)
+        return 0;
+    frameBytes = LoadFmn(key, &data);
+    if (frameBytes == 0)
+        return 0;
+    sSky[i].file = data;
+    strcpy(sSky[i].key, key);
+    *file = data;
+    return frameBytes;
 }
 
+void FollowerMon_SkyRelease(void)
+{
+    u32 i;
+
+    for (i = 0; i < SKY_FILES; i++)
+    {
+        free(sSky[i].file);
+        sSky[i].file = NULL;
+        sSky[i].key[0] = '\0';
+    }
+}
+
+/* Where the rider sits on a frame seen from the side, as FollowerMon_FlySprite
+ * seats the player: from the sprite's centre; 0, -8 (the bird's) if blank. */
+void FollowerMon_SkySeat(const u8 *frameTiles, u32 width, s8 *seatX, s8 *seatY)
+{
+    int bx0, by0, bx1, by1;
+
+    *seatX = 0;
+    *seatY = -8;
+    FrameBox(frameTiles, width, &bx0, &by0, &bx1, &by1);
+    if (bx1 >= 0)
+    {
+        *seatX = (bx0 + bx1 + 1) / 2 - (int)width / 2;
+        *seatY = by0 + 4 - (int)width / 2;
+    }
+}
+

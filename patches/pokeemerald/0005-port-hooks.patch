@@ -214,6 +216,13 @@ bool32 CheckHeap()
 {
     struct MemBlock *pos = (struct MemBlock *)sHeapStart;
 
+#if defined(PORT_BRIDGE) && !defined(PORT_HEAP_CHECK)
+    // The port only feeds this to debug traces, many of them on per-tile and

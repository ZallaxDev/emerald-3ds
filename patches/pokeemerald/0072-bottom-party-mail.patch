+#ifdef PORT_BRIDGE
+/*
+ * GIVE with a MAIL from the bottom screen's party: given as CB2_GiveHoldItem
+ * and Task_HandleSwitchItemsYesNoInput give it (the item held back to the
+ * bag), then written on the game's own screen (CB2_WriteMailToGiveMon),
+ * which the field fades out for and comes back to. Cancelled, it is all put
+ * back as CB2_ReturnToPartyMenuFromWritingMail puts it.
+ */
+static u8 sCtrMailResult;
+static u16 sCtrMailItem;
+
+static void CB2_CtrReturnFromWritingMail(void)
+{
+    struct Pokemon *mon = &gPlayerParty[gPartyMenu.slotId];
+    u16 item = GetMonData(mon, MON_DATA_HELD_ITEM);
+
+    if (gSpecialVar_Result == FALSE)
+    {
+        TakeMailFromMon(mon);
+        SetMonData(mon, MON_DATA_HELD_ITEM, &sPartyMenuItemId);
+        if (sPartyMenuItemId != ITEM_NONE)
+            RemoveBagItem(sPartyMenuItemId, 1);
+        AddBagItem(item, 1);
+        sCtrMailResult = CTR_MAIL_CANCELLED;
+    }
+    else
+    {
+        sCtrMailResult = CTR_MAIL_WRITTEN;
+    }
+    SetMainCallback2(CB2_ReturnToField);
+}
+
+static void CB2_CtrWriteMail(void)
+{
+    u8 mail = GetMonData(&gPlayerParty[gPartyMenu.slotId], MON_DATA_MAIL);
+
+    DoEasyChatScreen(EASY_CHAT_TYPE_MAIL, gSaveBlock1Ptr->mail[mail].words, CB2_CtrReturnFromWritingMail,
+                     EASY_CHAT_PERSON_DISPLAY_NONE);
+}
+
+static void Task_CtrOpenMailWriting(u8 taskId)
+{
+    if (!gPaletteFade.active)
+    {
+        PlayRainStoppingSoundEffect();
+        CleanupOverworldWindowsAndTilemaps();
+        SetMainCallback2(CB2_CtrWriteMail);
+        DestroyTask(taskId);
+    }
 }
+
+u8 CtrParty_GiveMail(u8 slot, u16 mail)
+{
+    struct Pokemon *mon = &gPlayerParty[slot];
+    u16 held = GetMonData(mon, MON_DATA_HELD_ITEM);
+
+    if (!ItemIsMail(mail) || CheckBagHasItem(mail, 1) != TRUE || ItemIsMail(held))
+        return CTR_MAIL_FAILED;
+    RemoveBagItem(mail, 1);
+    if (held != ITEM_NONE && AddBagItem(held, 1) == FALSE)
+    {
+        AddBagItem(mail, 1);
+        return CTR_MAIL_BAG_FULL;
+    }
+    GiveItemToMon(mon, mail);
+    if (GetMonData(mon, MON_DATA_HELD_ITEM) != mail)
+    {
+        if (held != ITEM_NONE)
+            RemoveBagItem(held, 1);
+        AddBagItem(mail, 1);
+        return CTR_MAIL_FAILED;
+    }
+    gPartyMenu.slotId = slot;
+    sPartyMenuItemId = held;
+    sCtrMailItem = mail;
+    sCtrMailResult = CTR_MAIL_WRITING;
+    LockPlayerFieldControls();
+    FadeScreen(FADE_TO_BLACK, 0);
+    CreateTask(Task_CtrOpenMailWriting, 8);
+    return CTR_MAIL_WRITING;
+}
+
+// Once: WRITTEN or CANCELLED, with the MAIL and the item it replaced.
+u8 CtrParty_MailResult(u16 *mail, u16 *oldItem)
+{
+    u8 result = sCtrMailResult;
+
+    if (result == CTR_MAIL_WRITTEN || result == CTR_MAIL_CANCELLED)
+    {
+        *mail = sCtrMailItem;
+        *oldItem = sPartyMenuItemId;
+        sCtrMailResult = CTR_MAIL_NONE;
+        return result;
+    }
+    return CTR_MAIL_NONE;
+}
 #endif

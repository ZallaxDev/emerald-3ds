+#ifdef PORT_BRIDGE
+// ReadMail, CB2_InitMailRead, BufferMailText and PrintMailText's choices for
+// `mail`, for the bottom screen to draw (3ds_bottom_ui.c).
+void CtrMail_View(struct Mail *mail, struct CtrMailView *view)
+{
+    const struct MailLayout *layout;
+    u8 type, *ptr, name[12];
+    u16 i, y = 0, numWords = 0, buffer[2], species;
+    bool8 hasText = TRUE;
+
+    memset(view, 0, sizeof(*view));
+    if (IS_ITEM_MAIL(mail->itemId))
+    {
+        type = ITEM_TO_MAIL(mail->itemId);
+    }
+    else
+    {
+        type = ITEM_TO_MAIL(FIRST_MAIL_INDEX);
+        hasText = FALSE;
+    }
+    layout = &sMailLayouts_Tall[type];
+    view->palette = sMailGraphics[type].palette;
+    view->tiles = sMailGraphics[type].tiles;
+    view->tileMap = sMailGraphics[type].tileMap;
+    view->textColor = sMailGraphics[type].textColor;
+    view->textShadow = sMailGraphics[type].textShadow;
+    view->barColors[0] = sBgColors[gSaveBlock2Ptr->playerGender][0];
+    view->barColors[1] = sBgColors[gSaveBlock2Ptr->playerGender][1];
+    species = MailSpeciesToSpecies(mail->species, buffer);
+    if (species > SPECIES_NONE && species < NUM_SPECIES
+     && (type == ITEM_TO_MAIL(ITEM_BEAD_MAIL) || type == ITEM_TO_MAIL(ITEM_DREAM_MAIL)))
+    {
+        view->iconSpecies = GetIconSpeciesNoPersonality(mail->species);
+        view->iconX = type == ITEM_TO_MAIL(ITEM_BEAD_MAIL) ? 96 : 40;
+        view->iconY = 128;
     }
+    if (!hasText)
+        return;
+
+    // The message window is at tiles (2, 3).
+    for (i = 0; i < layout->numLines && view->numLines < CTR_MAIL_LINES; i++)
+    {
+        u8 *line = view->lines[view->numLines];
+
+        ConvertEasyChatWordsToString(line, &mail->words[numWords], layout->lines[i].numEasyChatWords, 1);
+        numWords += layout->lines[i].numEasyChatWords;
+        if (line[0] == EOS || line[0] == CHAR_SPACE)
+            continue;
+        view->lineX[view->numLines] = 16 + layout->lines[i].xOffset + layout->wordsXPos;
+        view->lineY[view->numLines] = 24 + y + layout->wordsYPos;
+        y += layout->lines[i].height;
+        view->numLines++;
+    }
+    StringCopy(name, mail->playerName);
+    ConvertInternationalPlayerName(name);
+    ptr = StringCopy(view->signature, gText_FromSpace);
+    StringCopy(ptr, name);
+    view->signatureX = 16 + GetStringCenterAlignXOffset(FONT_NORMAL, view->signature, layout->signatureWidth) + 104;
+    view->signatureY = 24 + layout->signatureYPos + 88;
 }
+#endif

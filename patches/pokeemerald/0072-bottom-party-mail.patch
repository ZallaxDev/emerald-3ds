+#ifdef PORT_BRIDGE
+// CtrParty_GiveMail's outcomes, and CtrParty_MailResult's after writing.
+enum {
+    CTR_MAIL_NONE,
+    CTR_MAIL_FAILED,            // no MAIL slot, or not in the bag
+    CTR_MAIL_BAG_FULL,          // no room for the item held

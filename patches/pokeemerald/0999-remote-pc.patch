+#ifdef PLATFORM_3DS
+/* Enter the existing box mover without a physical PC's script/menu.  Let
+ * the ordinary overworld task drive the fade before replacing its callback. */
+static void Task_CtrRemotePc(u8 taskId)
+{
+    (void)taskId;
+    if (gPaletteFade.active)
+        return;
+    CleanupOverworldWindowsAndTilemaps();
+    EnterPokeStorage(OPTION_MOVE_MONS); /* Resets the field's tasks. */
+}
+
+bool8 CtrStorage_OpenRemote(void)
+{
+    u8 i;
+
+    /* CreateTask returns task 0 on exhaustion, so check for a free slot. */
+    for (i = 0; i < NUM_TASKS && gTasks[i].isActive; ++i)
+        ;
+    if (i == NUM_TASKS)
+        return FALSE;
+
+    sCtrRemotePc = TRUE;
+    LockPlayerFieldControls();
+    CreateTask(Task_CtrRemotePc, 80);
+    CtrBottom_KeepWorld();
+    FadeScreen(FADE_TO_BLACK, 0);
+    return TRUE;
+}
+#endif
+
 void ShowPokemonStorageSystemPC(void)
 {
     u8 taskId = CreateTask(Task_PCMainMenu, 80);

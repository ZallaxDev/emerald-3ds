 {
     sPreviousBoxOption = GetCurrentBoxOption();
-    gFieldCallback = FieldTask_ReturnToPcMenu;
+#ifdef PLATFORM_3DS
+    if (sCtrRemotePc)
+    {
+        sCtrRemotePc = FALSE;
+        gFieldCallback = FieldCB_ReturnToFieldNoScript;
+    }
+    else
+#endif
+        gFieldCallback = FieldTask_ReturnToPcMenu;
     SetMainCallback2(CB2_ReturnToField);
 }
 

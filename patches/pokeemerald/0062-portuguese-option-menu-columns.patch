+    DrawOptionMenuChoice(gText_BattleSceneOff, GetStringRightAlignXOffset(FONT_NORMAL, gText_BattleSceneOff, CHOICES_RIGHT), YPOS_BATTLESCENE, styles[1]);
 }
 

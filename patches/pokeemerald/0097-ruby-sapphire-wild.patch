+// The surfing table as met (3ds_encounters.h: RUBY/SAPPHIRE POKEMON).
+static const struct WildPokemonInfo *GetWaterMonsInfo(u16 headerId)
+{
+    const struct WildPokemonHeader *header = &gWildMonHeaders[headerId];

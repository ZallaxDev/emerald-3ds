index 6fd3cda..298ee03 100644
--- a/src/battle_ai_script_commands.c
+++ b/src/battle_ai_script_commands.c
@@ -149,6 +149,8 @@ static void Cmd_is_of_type(void);
 static void Cmd_if_target_is_ally(void);

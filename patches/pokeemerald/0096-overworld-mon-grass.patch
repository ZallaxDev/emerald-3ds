+/*
+ * The grass it stands in or steps into, as an object's ground effects have
+ * it (event_object_movement.c): the tall grass rustles and then covers its
+ * feet, long grass too. Its owner is the slot's grass id (LOCALID_VISIBLE_WILD,
+ * VisibleWild_GrassOwner), so the grass stays while it stands there and goes
+ * once it has walked off, vanished or met the player. Left out when the field
+ * is short of sprites: the objects that come into view need theirs.
+ */
+#if VW_MAX > VISIBLE_WILD_GRASS_IDS
+#error "a visible wild Pokemon without a grass id"
+#endif
+#define VW_GRASS_SPARE 12        /* sprites left free for the field */
+
+static u8 VisibleElevation(const struct VisibleWild *v)
+{
+    u8 elevation = MapGridGetElevationAt(v->x, v->y);
+
+    /* 0 and 15 go with any: an object there keeps the one it had. */
+    if (elevation == 0 || elevation == 15)
+        elevation = gObjectEvents[gPlayerAvatar.objectEventId].previousElevation;
+    return elevation;
+}
+
+static void VisibleGrass(const struct VisibleWild *v, s16 x, s16 y, bool8 settled)
+{
+    u32 behavior = MapGridGetMetatileBehaviorAt(x, y);
+    u32 i, free = 0;
+    u8 effect;
+
+    if (v->water)
+        return;
+    if (MetatileBehavior_IsTallGrass(behavior))
+        effect = FLDEFF_TALL_GRASS;
+    else if (MetatileBehavior_IsLongGrass(behavior))
+        effect = FLDEFF_LONG_GRASS;
+    else
+        return;
+    for (i = 0; i < MAX_SPRITES; i++)
+        free += !gSprites[i].inUse;
+    if (free <= VW_GRASS_SPARE)
+        return;
+    gFieldEffectArguments[0] = x;
+    gFieldEffectArguments[1] = y;
+    gFieldEffectArguments[2] = VisibleElevation(v);
+    gFieldEffectArguments[3] = 2;
+    gFieldEffectArguments[4] = (LOCALID_VISIBLE_WILD + (v - sVisible)) << 8 | gSaveBlock1Ptr->location.mapNum;
+    gFieldEffectArguments[5] = gSaveBlock1Ptr->location.mapGroup;
+    gFieldEffectArguments[6] = (u8)gSaveBlock1Ptr->location.mapNum << 8 | (u8)gSaveBlock1Ptr->location.mapGroup;
+    gFieldEffectArguments[7] = settled;
+    FieldEffectStart(effect);
+}
+
+bool8 VisibleWild_GrassOwner(u8 localId, s16 *x, s16 *y, s16 *fromX, s16 *fromY)
+{
+    const struct VisibleWild *v;
+
+    if (localId < LOCALID_VISIBLE_WILD || localId >= LOCALID_VISIBLE_WILD + VW_MAX)
+        return FALSE;
+    v = &sVisible[localId - LOCALID_VISIBLE_WILD];
+    if (!v->active || !VisibleSpriteValid(v))
+        return FALSE;
+    /* Mid-step it is on its way onto the next tile, as an object then is. */
+    *x = v->x + (v->progress ? v->dx : 0);
+    *y = v->y + (v->progress ? v->dy : 0);
+    *fromX = v->x;
+    *fromY = v->y;
+    return TRUE;
+}
+
 /* Growing (or shrinking): its size this frame, on its OAM matrix. Done, the
  * sprite is an ordinary one again. Eased: fast at first, settling at the end. */
 static void VisibleScaleStep(struct VisibleWild *v)
@@ -1046,8 +1115,15 @@ static void VisiblePlace(struct VisibleWild *v)
         if (v->scaleFrames == 0)
             FollowerMon_WildFace(sprite, v->faceX, v->faceY, v->progress != 0);
     }
-    /* Further down the screen, drawn over: as the map's objects are. */
-    sprite->subpriority = 200 - ((sprite->y + 64) >> 1 & 0x7F);
+    /* Further down the screen, drawn over: by the objects' own rule, so the
+     * grass it stands in (VisibleGrass) is drawn over its feet as over theirs,

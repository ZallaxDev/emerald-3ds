+/* Where the one a grass effect belongs to stands (x, y) and steps from: an
+ * object event's current and previous tiles, or those of a visible wild
+ * Pokemon, a sprite with no object (LOCALID_VISIBLE_WILD). FALSE: gone. */
+static bool8 GrassWalkerAt(struct Sprite *sprite, s16 *x, s16 *y, s16 *fromX, s16 *fromY)
+{
+    u8 localId = sprite->sLocalId;
+    u8 objectEventId;
+
+    if (localId >= LOCALID_VISIBLE_WILD && localId < LOCALID_VISIBLE_WILD + VISIBLE_WILD_GRASS_IDS)
+        return VisibleWild_GrassOwner(localId, x, y, fromX, fromY);
+    /* The follower takes the player's map as it crosses into the next one
+     * (follower_mon.c): its grass from the last map is still its own. */
+    if (localId == LOCALID_FOLLOWER)
+    {
+        for (objectEventId = 0; objectEventId < OBJECT_EVENTS_COUNT; objectEventId++)
+            if (FollowerMon_IsFollower(&gObjectEvents[objectEventId]))
+                break;
+        if (objectEventId == OBJECT_EVENTS_COUNT)
+            return FALSE;
+    }
+    else if (TryGetObjectEventIdByLocalIdAndMap(localId, sprite->sMapNum, sprite->sMapGroup, &objectEventId))
+    {
+        return FALSE;
+    }
+    *x = gObjectEvents[objectEventId].currentCoords.x;
+    *y = gObjectEvents[objectEventId].currentCoords.y;
+    *fromX = gObjectEvents[objectEventId].previousCoords.x;
+    *fromY = gObjectEvents[objectEventId].previousCoords.y;
+    return TRUE;
+}
+
+/*
+ * A step's rustle starting on a tile: an earlier grass effect of the same kind
+ * on that tile goes. The two were drawn one over the other by sprite order,
+ * and in the voxel view as two decals in one plane: the follower, stepping
+ * where the player stood a moment before, had its rustle hidden under the
+ * player's grass, still there (its owner had only just left) and mostly
+ * settled; the player walking into the follower (they swap tiles), the other
+ * way round. Only one walker stands on a tile, and the newest grass is the
+ * same picture once settled: whoever is still leaving the tile stays as
+ * covered by it as by its own.
+ */
+static void RetireOlderGrass(void (*callback)(struct Sprite *), u8 fldEff)
+{
+    s16 x = gFieldEffectArguments[0];
+    s16 y = gFieldEffectArguments[1];
+    u32 i;
+
+    if (gFieldEffectArguments[7])
+        return;   /* appearing already in it (skip to the end): nothing rustles */
+    for (i = 0; i < MAX_SPRITES; i++)
+    {
+        struct Sprite *sprite = &gSprites[i];
+
+        if (sprite->inUse && sprite->callback == callback && sprite->sX == x && sprite->sY == y)
+            FieldEffectStop(sprite, fldEff);
+    }
+}

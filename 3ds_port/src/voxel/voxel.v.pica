; Voxel terrain vertex shader.
;
; position + shade packed as four shorts, texcoord as two floats (16 bytes, see
; VoxelGpuVertex in ctr_voxel.c). Positions are in 1/512 tile relative to the
; draw's origin; shade is 1/16384. The origin is added here, in whole tiles
; from an anchor near the camera that modelView carries: a shared edge of two
; chunks then reaches the matrix as the same numbers, exactly. Folded into each
; chunk's own modelView, it was rounded differently on either side and the seam
; opened a row of background pixels as the camera moved. Optional fixed-sun
; lighting is baked on the CPU into shade.
;
; Per vertex, the shader turns that brightness into a colour grade and a haze
; weight (see VoxelGrade in ctr_voxel.c):
;   t      = clamp(shade * grade.x + grade.y, 0, 1)   how sunlit the vertex is
;   colour = shade * (shadeTint + tintDiff * t)       cool in shadow, warm in sun
;   haze   = clamp(-viewZ * fog.x + fog.y, 0, fog.z)  further is hazier
; The colour carries half its value: the texture environment doubles it, so
; sun can brighten a texel instead of only ever darkening it. The haze weight
; goes out as 1 - haze in alpha, which the haze environment uses to mix
; towards the haze colour; texture alpha alone decides transparency.
;
; texcoord1 places the sun dapples (see DappleUniforms in ctr_voxel.c): the
; position, slid along the sun by its height, rotated and scaled into the
; pattern, which the world and sprites sample (and the rays, turned).
;   dapple = (dappleU . position, dappleV . position)

.fvec projection[4], modelView[4], origin
.fvec shadeTint, tintDiff, grade, fog
.fvec dappleU, dappleV

; x: position scale, y: shade scale, z: 0, w: 1
.constf ctrVoxelConst(0.001953125, 0.00006103515625, 0.0, 1.0)
.alias  ones  ctrVoxelConst.wwww
.alias  zeros ctrVoxelConst.zzzz

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outclr color

.alias inpos v0 ; x, y, z, shade
.alias intex v1 ; u, v

.proc main
	mul r0.xyz, ctrVoxelConst.xxxx, inpos
	mov r0.w,   ones

	; r7 = position from the anchor (origin.w is 0)
	add r7, origin, r0

	; r1 = modelView * r7
	dp4 r1.x, modelView[0], r7
	dp4 r1.y, modelView[1], r7
	dp4 r1.z, modelView[2], r7
	dp4 r1.w, modelView[3], r7

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intex
	mov outtc2, intex

	; r6 = the dapple pattern's coordinates
	mov r6, zeros
	dp4 r6.x, dappleU, r0
	dp4 r6.y, dappleV, r0
	mov outtc1, r6

	; r2 = shade, r3 = t
	mul r2, ctrVoxelConst.yyyy, inpos.wwww
	mul r3, grade.xxxx, r2
	add r3, grade.yyyy, r3
	max r3, zeros, r3
	min r3, ones, r3

	; r4 = shade * lerp(shadeTint, sunTint, t)
	mul r4, tintDiff, r3
	add r4, shadeTint, r4
	mul r4, r2, r4
	mov outclr.xyz, r4

	; r5 = haze from view-space depth (the camera looks down -Z)
	mul r5, fog.xxxx, r1.zzzz
	add r5, fog.yyyy, r5
	max r5, zeros, r5
	min r5, fog.zzzz, r5
	add outclr.w, ones, -r5

	end
.end
